@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - Power Fitness</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #146c43;
            --primary-dark: #0e5636;
            --primary-press: #0a3f27;
            --ink: #062117;
            --lime: #c5f04d;
            --paper: #f6f4ec;
            --text: #10241b;
            --text-muted: #4b5f55;
            --on-dark: #e9f4ee;
            --on-dark-muted: #a9c4b6;
            --line: #6f8578;
            --danger: #b42318;
            --radius: 12px;
            --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
            --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: var(--font-body);
            color: var(--on-dark);
            background: radial-gradient(1100px 560px at 90% -10%, rgba(20, 108, 67, 0.6), transparent 60%), radial-gradient(800px 480px at -10% 110%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
            min-height: 100vh;
        }

            /* Diagonal training-track texture */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                pointer-events: none;
                background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
            }

        .stage {
            position: relative;
            min-height: 100vh;
            min-height: 100dvh;
            max-width: 1100px;
            margin-inline: auto;
            padding: clamp(1.25rem, 4vw, 3rem);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        /* ---------- Brand ---------- */
        .brand {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .brand-mark {
            width: 48px;
            height: 48px;
            flex: none;
        }

        .brand-name {
            margin: 0;
            font-family: var(--font-display);
            font-size: 1.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            line-height: 1;
            color: #fff;
        }

        .brand-tagline {
            margin: 0.3rem 0 0;
            font-size: 0.875rem;
            color: var(--on-dark-muted);
        }

        /* ---------- Main ---------- */
        .denied {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.5rem;
            padding-bottom: 1rem;
        }

        /* 4 [weight plate + lock] 3 */
        .code {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.04em;
            font-family: var(--font-display);
            font-size: clamp(7rem, 20vw, 12rem);
            font-weight: 700;
            line-height: 0.8;
            user-select: none;
        }

        .digit {
            color: rgba(197, 240, 77, 0.1);
            -webkit-text-stroke: 3px var(--lime);
            paint-order: stroke fill;
            animation: rise .55s cubic-bezier(.2, .7, .2, 1) backwards;
        }

            .digit:last-child {
                animation-delay: .15s;
            }

        .plate-lock {
            width: 0.8em;
            height: 0.8em;
            flex: none;
            animation: pop .5s cubic-bezier(.2, .7, .2, 1) .1s backwards;
        }

        .plate-body {
            fill: var(--primary);
            stroke: var(--lime);
            stroke-width: 6;
        }

        .plate-ring {
            fill: none;
            stroke: rgba(197, 240, 77, 0.5);
            stroke-width: 3;
            stroke-dasharray: 3 9;
            stroke-linecap: round;
        }

        .plate-disc {
            fill: var(--ink);
            stroke: var(--lime);
            stroke-width: 3;
        }

        .lock-shackle {
            fill: none;
            stroke: var(--lime);
            stroke-width: 8;
            stroke-linecap: round;
            animation: clunk .5s cubic-bezier(.3, 1.5, .5, 1) .8s backwards;
        }

        .lock-body {
            fill: var(--lime);
        }

        .lock-hole {
            fill: var(--ink);
        }

        /* ---------- Card ---------- */
        .denied-card {
            position: relative;
            overflow: hidden;
            width: 100%;
            max-width: 680px;
            padding: calc(14px + 2rem) clamp(1.5rem, 4vw, 2.5rem) clamp(1.75rem, 4vw, 2.5rem);
            background: var(--paper);
            color: var(--text);
            border-radius: 28px 28px 28px 6px;
            box-shadow: 12px 12px 0 var(--primary);
            animation: rise .55s cubic-bezier(.2, .7, .2, 1) .2s backwards;
        }

            /* Restricted-area tape */
            .denied-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 14px;
                background: repeating-linear-gradient(-45deg, var(--ink) 0 12px, var(--lime) 12px 24px);
            }

        .card-title {
            margin: 0 0 1rem;
            font-family: var(--font-display);
            font-size: clamp(2.5rem, 6vw, 3.75rem);
            font-weight: 700;
            line-height: 1;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            color: var(--primary);
        }

        .hl {
            padding: 0 0.2em;
            border-radius: 6px;
            background: var(--lime);
            color: var(--ink);
            -webkit-box-decoration-break: clone;
            box-decoration-break: clone;
        }

        .msg {
            margin: 0 0 1.25rem;
            font-size: 1.0625rem;
            line-height: 1.6;
            color: var(--text-muted);
        }

        .error-code {
            margin: 0 0 1.25rem;
            padding: 0.8rem 1rem;
            border: 1.5px solid var(--line);
            border-left: 5px solid var(--danger);
            border-radius: 8px;
            background: #fff;
            color: var(--text);
            font-family: ui-monospace, 'Cascadia Mono', 'Courier New', monospace;
            font-size: 0.9375rem;
        }

        .button-group {
            margin-top: 1.75rem;
        }

        .btn-power {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            min-width: 240px;
            min-height: 56px;
            padding: 0 1.75rem;
            border-radius: var(--radius);
            background: var(--primary);
            color: #fff;
            font-family: var(--font-display);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: 0.07em;
            text-decoration: none;
            text-transform: uppercase;
            cursor: pointer;
            box-shadow: 0 4px 0 var(--primary-press);
            transition: background-color .2s ease, transform .15s ease, box-shadow .15s ease;
        }

            .btn-power svg {
                width: 1.1em;
                height: 1.1em;
                transition: transform .2s ease;
            }

            .btn-power:hover {
                background: var(--primary-dark);
                color: #fff;
            }

                .btn-power:hover svg {
                    transform: translateX(-4px);
                }

            .btn-power:active {
                transform: translateY(3px);
                box-shadow: 0 1px 0 var(--primary-press);
            }

            .btn-power:focus-visible {
                outline: 3px solid var(--primary);
                outline-offset: 3px;
            }

        /* ---------- Motion ---------- */
        @@keyframes rise {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pop {
            from {
                opacity: 0;
                transform: scale(0.85);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        @@keyframes clunk {
            from {
                transform: translateY(-10px);
            }

            to {
                transform: translateY(0);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .digit, .plate-lock, .lock-shackle, .denied-card {
                animation: none;
            }

            .btn-power, .btn-power svg {
                transition: none;
            }
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 480px) {
            .denied-card {
                box-shadow: 8px 8px 0 var(--primary);
            }

            .btn-power {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="stage">

        <!-- Brand -->
        <header class="brand">
            <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <rect width="48" height="48" rx="12" fill="#146c43" />
                <path d="M6 24 H42" stroke="#fff" stroke-width="3" stroke-linecap="round" />
                <rect x="9" y="15" width="5" height="18" rx="2" fill="#fff" />
                <rect x="34" y="15" width="5" height="18" rx="2" fill="#fff" />
                <polygon points="28,8 16,26 23,26 19,40 32,21 25,21" fill="#c5f04d" stroke="#146c43" stroke-width="3" stroke-linejoin="round" paint-order="stroke" />
            </svg>
            <div>
                <p class="brand-name">Power Fitness</p>
                <p class="brand-tagline">Gym Management System</p>
            </div>
        </header>

        <!-- Main Content -->
        <main class="denied">
            <div class="code" aria-hidden="true">
                <span class="digit">4</span>
                <svg class="plate-lock" viewBox="0 0 200 200" fill="none" focusable="false">
                    <circle class="plate-body" cx="100" cy="100" r="96" />
                    <circle class="plate-ring" cx="100" cy="100" r="72" />
                    <circle class="plate-disc" cx="100" cy="100" r="52" />
                    <path class="lock-shackle" d="M84 98 V86 a16 16 0 0 1 32 0 V98" />
                    <rect class="lock-body" x="74" y="98" width="52" height="38" rx="8" />
                    <circle class="lock-hole" cx="100" cy="113" r="5" />
                    <rect class="lock-hole" x="98" y="115" width="4" height="11" rx="2" />
                </svg>
                <span class="digit">3</span>
            </div>

            <section class="denied-card">
                <h1 class="card-title">Access <span class="hl">Denied</span></h1>
                <p class="msg">
                    We’re sorry, but you don’t have permission to access this resource. Your current user role or membership status doesn’t grant you access to this section.
                </p>
                <div class="error-code">
                    Error Code: 403 - Forbidden Access
                </div>
                <p class="msg">
                    If you believe this is an error or need elevated permissions, please contact the system administrator or your membership manager for assistance.
                </p>
                <div class="button-group">
                    <a asp-action="Index" asp-controller="Home" class="btn-power">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                        Return to Home
                    </a>
                </div>
            </section>
        </main>

    </div>
</body>
</html>
