@model SessionViewModel
@{
    ViewData["Title"] = "Delete Session";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ============ Scope + tokens ============ */
    .pf-page {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --danger: #b42318;
        --danger-dark: #9c1f15;
        --danger-press: #7f1810;
        --danger-bg: #fdecea;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 620px;
        margin-inline: auto;
        padding: clamp(1.5rem, 5vw, 3rem) clamp(0.75rem, 2vw, 1.5rem) 4rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-page *, .pf-page *::before, .pf-page *::after {
            box-sizing: border-box;
        }

        .pf-page h1, .pf-page p {
            margin: 0;
            padding: 0;
        }

        .pf-page a {
            color: inherit;
            text-decoration: none;
        }

    .ico {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ============ Ticket (notched, with a tear-off footer) ============ */
    .ticket-wrap {
        filter: drop-shadow(8px 8px 0 var(--danger));
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) backwards;
    }

    .ticket {
        --foot: 96px;
        --y: calc(100% - var(--foot));
        overflow: hidden;
        border-radius: 22px;
        background: var(--paper);
        color: var(--text);
        -webkit-mask: radial-gradient(11px at 0 var(--y), #0000 98%, #000) left / 51% 100% no-repeat, radial-gradient(11px at 100% var(--y), #0000 98%, #000) right / 51% 100% no-repeat;
        mask: radial-gradient(11px at 0 var(--y), #0000 98%, #000) left / 51% 100% no-repeat, radial-gradient(11px at 100% var(--y), #0000 98%, #000) right / 51% 100% no-repeat;
    }

    .ticket-head {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        background: var(--danger);
        color: #fff;
    }

        .ticket-head .ico {
            width: 1.6rem;
            height: 1.6rem;
        }

    .ticket-title {
        font-family: var(--font-display);
        font-size: clamp(1.9rem, 5vw, 2.5rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .ticket-body {
        padding: 1.75rem clamp(1.25rem, 5vw, 2.5rem) 1.5rem;
        text-align: center;
    }

    /* Calendar with a red "void" stamp */
    .cal-art {
        display: block;
        width: 120px;
        height: 120px;
        margin: 0 auto 1.25rem;
        animation: pf-thud .55s cubic-bezier(.3, 1.5, .5, 1) .3s backwards;
    }

    .cal-body {
        fill: #fff;
        stroke: var(--ink);
        stroke-width: 5;
        stroke-linejoin: round;
    }

    .cal-top {
        fill: var(--danger);
        stroke: var(--ink);
        stroke-width: 5;
        stroke-linejoin: round;
    }

    .cal-ring {
        fill: none;
        stroke: var(--ink);
        stroke-width: 5;
        stroke-linecap: round;
    }

    .cal-x {
        fill: none;
        stroke: var(--danger);
        stroke-width: 8;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
    }

    .cal-x--a {
        animation: pf-draw .3s ease-out .75s backwards;
    }

    .cal-x--b {
        animation: pf-draw .3s ease-out 1s backwards;
    }

    .warning {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1rem 1.25rem;
        border-left: 5px solid var(--danger);
        border-radius: 14px;
        background: var(--danger-bg);
        text-align: left;
        color: var(--text);
    }

        .warning .ico {
            margin-top: 0.15rem;
            color: var(--danger);
        }

        .warning strong {
            color: var(--danger);
        }

    .question {
        margin-top: 1.25rem !important;
        font-size: 1.1875rem;
        font-weight: 500;
        color: var(--ink);
    }

    .hl-danger {
        padding: 0 0.2em;
        border-radius: 6px;
        background: var(--danger);
        color: #fff;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    /* tear-off footer: fixed height so the notches line up with the dashed edge */
    .ticket-foot {
        height: var(--foot);
        border-top: 2px dashed #b9c6bd;
    }

        .ticket-foot form {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            height: 100%;
            padding: 0 clamp(1.25rem, 5vw, 2.5rem);
        }

    .btn-safe,
    .btn-danger {
        display: inline-flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-width: 0;
        min-height: 54px;
        padding: 0 1rem;
        border: 0;
        border-radius: var(--radius);
        color: #fff;
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .btn-safe .ico,
        .btn-danger .ico {
            width: 1.15rem;
            height: 1.15rem;
            transition: transform .2s ease;
        }

    .btn-safe {
        background: var(--primary);
        box-shadow: 0 4px 0 var(--primary-press);
    }

        .btn-safe:hover {
            background: var(--primary-dark);
            color: #fff;
        }

            .btn-safe:hover .ico {
                transform: rotate(90deg);
            }

        .btn-safe:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 var(--primary-press);
        }

    .btn-danger {
        background: var(--danger);
        box-shadow: 0 4px 0 var(--danger-press);
    }

        .btn-danger:hover {
            background: var(--danger-dark);
        }

            .btn-danger:hover .ico {
                transform: rotate(-12deg) scale(1.15);
            }

        .btn-danger:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 var(--danger-press);
        }

        .btn-safe:focus-visible,
        .btn-danger:focus-visible {
            outline: 3px solid var(--ink);
            outline-offset: 3px;
        }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pf-thud {
        from {
            opacity: 0;
            transform: scale(1.35) rotate(-8deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0);
        }
    }

    @@keyframes pf-draw {
        from {
            stroke-dashoffset: 1;
        }

        to {
            stroke-dashoffset: 0;
        }
    }

    /* ============ Responsive ============ */
    @@media (max-width: 480px) {
        .ticket-wrap {
            filter: drop-shadow(5px 5px 0 var(--danger));
        }

        .btn-safe,
        .btn-danger {
            font-size: 1.15rem;
            padding: 0 0.5rem;
        }
    }

    /* ============ Reduced motion ============ */
    @@media (prefers-reduced-motion: reduce) {
        .pf-page *, .pf-page *::before, .pf-page *::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="pf-page">
    <div class="ticket-wrap">
        <div class="ticket">

            <div class="ticket-head">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4l9 16H3z" /><path d="M12 10v4M12 17.2v.1" /></svg>
                <h1 class="ticket-title">Delete Session</h1>
            </div>

            <div class="ticket-body">
                <svg class="cal-art" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                    <rect class="cal-body" x="20" y="26" width="80" height="76" rx="10" />
                    <path class="cal-top" d="M20 46V36a10 10 0 0110-10h60a10 10 0 0110 10v10z" />
                    <path class="cal-ring" d="M42 16v18M78 16v18" />
                    <path class="cal-x cal-x--a" pathLength="1" d="M44 62L76 92" />
                    <path class="cal-x cal-x--b" pathLength="1" d="M76 62L44 92" />
                </svg>

                <div class="warning">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 7.8v.1" /></svg>
                    <p>
                        <strong>Warning:</strong>
                        This action cannot be undone. All session data and bookings will be permanently deleted.
                    </p>
                </div>

                <p class="question">Are you sure you want to <span class="hl-danger">delete</span> this session?</p>
            </div>

            <div class="ticket-foot">
                <form asp-action="DeleteConfirmed" asp-route-id="@Context.Request.RouteValues["id"]" method="post">
                    <a asp-action="Index" class="btn-safe">
                        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
                        Cancel
                    </a>
                    <button type="submit" class="btn-danger deactiveButton">
                        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12M10 11v5M14 11v5" /></svg>
                        Delete
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
