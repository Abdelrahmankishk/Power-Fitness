@model CreateSessionViewModel
@{
    ViewData["Title"] = "Create Session";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ============ Scope + tokens ============ */
    .pf-page {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --on-dark-muted: #a9c4b6;
        --line: #6f8578;
        --danger: #b42318;
        --danger-bg: #fdecea;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 1000px;
        margin-inline: auto;
        padding: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem) 4rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-page *, .pf-page *::before, .pf-page *::after {
            box-sizing: border-box;
        }

        .pf-page h1, .pf-page h2, .pf-page p {
            margin: 0;
            padding: 0;
        }

        .pf-page a {
            color: inherit;
            text-decoration: none;
        }

    .ico {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ============ Alerts ============ */
    .pf-alert {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.85rem;
        padding: 1rem 1.25rem;
        border-left: 5px solid currentColor;
        border-radius: 14px;
        transition: opacity .3s ease, transform .3s ease, max-height .3s ease, margin .3s ease, padding .3s ease;
        animation: pf-rise .45s cubic-bezier(.2, .7, .2, 1) backwards;
    }

    .pf-alert--success {
        background: #e7f3ec;
        color: var(--primary);
    }

    .pf-alert--error {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .pf-alert-text {
        font-weight: 500;
        color: var(--text);
    }

    .pf-alert-close {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin: -0.5rem -0.75rem -0.5rem 0;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        transition: background-color .2s ease;
    }

        .pf-alert-close:hover {
            background: rgba(6, 33, 23, 0.1);
        }

        .pf-alert-close:focus-visible {
            outline: 3px solid currentColor;
            outline-offset: 0;
        }

    .pf-alert-timer {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 4px;
        background: currentColor;
        opacity: 0.4;
        transform-origin: left;
        animation: pf-timer var(--t, 6s) linear forwards;
    }

    .pf-alert:hover .pf-alert-timer,
    .pf-alert:focus-within .pf-alert-timer {
        animation-play-state: paused;
    }

    .pf-alert.is-leaving {
        max-height: 0 !important;
        margin-block: -0.75rem;
        padding-block: 0;
        opacity: 0;
        transform: translateY(-8px);
    }

    /* ============ Hero ============ */
    .page-wrap {
        position: relative;
    }

    .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: clamp(2rem, 5vw, 3.25rem) clamp(1.5rem, 5vw, 3.5rem) clamp(4.5rem, 8vw, 6rem);
        border-radius: 28px;
        background: radial-gradient(800px 420px at 100% 0%, rgba(20, 108, 67, 0.65), transparent 60%), radial-gradient(500px 320px at 0% 100%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) backwards;
    }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

    .hero-title {
        position: relative;
        padding-bottom: 1rem;
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6.5vw, 4.5rem);
        font-weight: 700;
        line-height: 0.95;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: #fff;
    }

        .hero-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 88px;
            height: 6px;
            border-radius: 999px;
            background: var(--lime);
        }

    .hero-sub {
        margin-top: 0.9rem;
        font-size: 1.125rem;
        color: var(--on-dark-muted);
    }

    .hero-art {
        flex: none;
        width: 120px;
        height: 120px;
    }

    .art-ring {
        fill: none;
        stroke: var(--lime);
        stroke-width: 3;
        stroke-dasharray: 3 10;
        stroke-linecap: round;
        transform-box: fill-box;
        transform-origin: center;
        animation: pf-spin 24s linear infinite;
    }

    .art-plate {
        fill: var(--primary);
        stroke: var(--lime);
        stroke-width: 4;
    }

    .art-cal {
        fill: none;
        stroke: var(--lime);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ============ Form card ============ */
    .form-card {
        position: relative;
        z-index: 2;
        margin: -3rem clamp(0.5rem, 3vw, 2rem) 0;
        padding: clamp(1.25rem, 3vw, 2.25rem);
        border-radius: 28px 28px 28px 6px;
        background: var(--paper);
        box-shadow: 12px 12px 0 var(--primary);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) .2s backwards;
    }

        .form-card .text-danger {
            color: var(--danger) !important;
        }

    /* arrow-tag section headings */
    .section-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.1rem;
    }

        .section-head::after {
            content: '';
            flex: 1;
            border-top: 2px dashed #b9c6bd;
        }

        .section-head h2 {
            padding: 0.3rem 1.9rem 0.3rem 1rem;
            background: var(--lime);
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            white-space: nowrap;
            color: var(--ink);
            clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
        }

    .section-head--spaced {
        margin-top: 2rem;
    }

    .fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem 1.25rem;
    }

    .field--wide {
        grid-column: 1 / -1;
    }

    .field {
        animation: pf-rise .45s cubic-bezier(.2, .7, .2, 1) calc(var(--i, 0) * 60ms + .3s) backwards;
    }

    .field-label {
        display: block;
        margin-bottom: 0.4rem;
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--text);
    }

    .field-control {
        position: relative;
    }

        .field-control .ico {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            color: #3f5a4b;
            pointer-events: none;
        }

        .field-control .ico-lead {
            left: 16px;
        }

        .field-control .ico-chev {
            right: 16px;
            transition: transform .2s ease;
        }

        .field-control:focus-within .ico-chev {
            transform: translateY(-50%) rotate(180deg);
        }

    .field-input,
    .field-select,
    .field-textarea {
        width: 100%;
        border: 1.5px solid var(--line);
        border-radius: var(--radius);
        background: #fff;
        font: inherit;
        font-size: 1rem;
        color: var(--text);
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .field-input,
    .field-select {
        height: 52px;
        padding: 0 16px 0 48px;
    }

    .field-select {
        padding-right: 48px;
        cursor: pointer;
        -webkit-appearance: none;
        appearance: none;
    }

        .field-select:has(option:checked[value=""]) {
            color: #5a6d62;
        }

        .field-select option {
            color: var(--text);
        }

    .field-input::placeholder,
    .field-textarea::placeholder {
        color: #5a6d62;
        opacity: 1;
    }

    .field-textarea {
        display: block;
        min-height: 130px;
        padding: 14px 16px;
        line-height: 1.5;
        resize: vertical;
    }

        .field-input:hover,
        .field-select:hover,
        .field-textarea:hover {
            border-color: var(--primary);
        }

        .field-input:focus,
        .field-select:focus,
        .field-textarea:focus {
            outline: 2px solid transparent;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(20, 108, 67, 0.22);
        }

        .field-input.input-validation-error,
        .field-select.input-validation-error,
        .field-textarea.input-validation-error {
            border-color: var(--danger);
        }

            .field-input.input-validation-error:focus,
            .field-select.input-validation-error:focus,
            .field-textarea.input-validation-error:focus {
                box-shadow: 0 0 0 4px rgba(180, 35, 24, 0.2);
            }

    .hint {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.875rem;
        color: var(--text-muted);
    }

    .field-error {
        display: block;
        min-height: 1.25rem;
        margin-top: 0.35rem;
        font-size: 0.875rem;
    }

    /* Start -> End row with an arrow between the two inputs */
    .when {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1fr);
        gap: 0.5rem 0.75rem;
        align-items: start;
    }

    .when-arrow {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-top: 2.1rem;
        border-radius: 50%;
        background: var(--ink);
        color: var(--lime);
    }

    /* ============ Buttons ============ */
    .form-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.75rem;
        padding-top: 1.5rem;
        border-top: 2px dashed #b9c6bd;
    }

    .btn-ghost,
    .btn-power {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 56px;
        padding: 0 1.75rem;
        border-radius: var(--radius);
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .btn-ghost .ico,
        .btn-power .ico {
            transition: transform .2s ease;
        }

    .btn-ghost {
        border: 2px solid var(--line);
        background: transparent;
        color: var(--ink);
    }

        .btn-ghost:hover {
            border-color: var(--ink);
            background: #e9ede4;
        }

            .btn-ghost:hover .ico {
                transform: translateX(-4px);
            }

        .btn-ghost:active {
            transform: translateY(3px);
        }

    .btn-power {
        border: 0;
        background: var(--primary);
        color: #fff;
        box-shadow: 0 4px 0 var(--primary-press);
    }

        .btn-power:hover {
            background: var(--primary-dark);
        }

            .btn-power:hover .ico {
                transform: scale(1.2);
            }

        .btn-power:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 var(--primary-press);
        }

        .btn-ghost:focus-visible,
        .btn-power:focus-visible {
            outline: 3px solid var(--ink);
            outline-offset: 3px;
        }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pf-timer {
        to {
            transform: scaleX(0);
        }
    }

    @@keyframes pf-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ============ Responsive ============ */
    @@media (max-width: 767.98px) {
        .fields {
            grid-template-columns: 1fr;
        }

        .hero-art {
            display: none;
        }

        .when {
            grid-template-columns: 1fr;
        }

        .when-arrow {
            display: none;
        }
    }

    @@media (max-width: 575.98px) {
        .form-card {
            box-shadow: 8px 8px 0 var(--primary);
        }

        .btn-ghost,
        .btn-power {
            flex: 1 1 100%;
        }
    }

    /* ============ Reduced motion ============ */
    @@media (prefers-reduced-motion: reduce) {
        .pf-page *, .pf-page *::before, .pf-page *::after {
            animation: none !important;
            transition: none !important;
        }

        .pf-alert-timer {
            display: none;
        }
    }
</style>

<div class="pf-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="Alert" class="pf-alert pf-alert--success" role="status" data-timeout="6000">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
            <p class="pf-alert-text">@TempData["SuccessMessage"]</p>
            <button type="button" class="pf-alert-close" aria-label="Close">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <span class="pf-alert-timer" style="--t:6s" aria-hidden="true"></span>
        </div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div id="Alert" class="pf-alert pf-alert--error" role="alert" data-timeout="10000">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4l9 16H3z" /><path d="M12 10v4M12 17.2v.1" /></svg>
            <p class="pf-alert-text">@TempData["ErrorMessage"]</p>
            <button type="button" class="pf-alert-close" aria-label="Close">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <span class="pf-alert-timer" style="--t:10s" aria-hidden="true"></span>
        </div>
    }

    <div class="page-wrap">

        <header class="hero">
            <div>
                <h1 class="hero-title">Create New Session</h1>
                <p class="hero-sub">Schedule a new training session</p>
            </div>

            <svg class="hero-art" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                <circle class="art-ring" cx="60" cy="60" r="56" />
                <circle class="art-plate" cx="60" cy="60" r="44" />
                <g class="art-cal">
                    <rect x="40" y="44" width="40" height="36" rx="6" />
                    <path d="M40 56h40M50 38v10M70 38v10M60 63v10M55 68h10" />
                </g>
            </svg>
        </header>

        <form asp-action="Create" method="post" class="form-card">

            <!-- Session Information -->
            <div class="section-head">
                <h2>Session Information</h2>
            </div>

            <div class="fields">
                <div class="field" style="--i:0">
                    <label asp-for="CategoryId" class="field-label">
                        Category <span class="text-danger">*</span>
                    </label>
                    <div class="field-control">
                        <svg class="ico ico-lead" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12V4h8l10 10-8 8z" /><circle cx="7.5" cy="8.5" r="1.5" /></svg>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="field-select">
                            <option value="">Select Category</option>
                        </select>
                        <svg class="ico ico-chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
                    </div>
                    <span asp-validation-for="CategoryId" class="text-danger field-error"></span>
                </div>

                <div class="field" style="--i:1">
                    <label asp-for="TrainerId" class="field-label">
                        Trainer <span class="text-danger">*</span>
                    </label>
                    <div class="field-control">
                        <svg class="ico ico-lead" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" /><path d="M4 20c1-4 4-6 8-6s7 2 8 6" /></svg>
                        <select asp-for="TrainerId" asp-items="ViewBag.Trainers" class="field-select">
                            <option value="">Select Trainer</option>
                        </select>
                        <svg class="ico ico-chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
                    </div>
                    <span asp-validation-for="TrainerId" class="text-danger field-error"></span>
                </div>

                <div class="field field--wide" style="--i:2">
                    <label asp-for="Description" class="field-label">
                        Description <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Description" class="field-textarea" rows="3"
                              placeholder="Describe the session content and objectives..."></textarea>
                    <span asp-validation-for="Description" class="text-danger field-error"></span>
                </div>

                <div class="field" style="--i:3">
                    <label asp-for="Capacity" class="field-label">
                        Capacity <span class="text-danger">*</span>
                    </label>
                    <div class="field-control">
                        <svg class="ico ico-lead" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.8-3.5 3.3-5.5 6.5-5.5s5.7 2 6.5 5.5" /><path d="M16 4.7a3.5 3.5 0 010 6.6M18.5 14.8c1.6.7 2.7 2.2 3 4.2" /></svg>
                        <input asp-for="Capacity" type="number" class="field-input" placeholder="25" min="1" max="25" />
                    </div>
                    <small class="hint">Maximum number of participants</small>
                    <span asp-validation-for="Capacity" class="text-danger field-error"></span>
                </div>
            </div>

            <!-- Date & Time -->
            <div class="section-head section-head--spaced">
                <h2>Date &amp; Time</h2>
            </div>

            <div class="when">
                <div class="field" style="--i:4">
                    <label asp-for="StartDate" class="field-label">
                        Start Date &amp; Time <span class="text-danger">*</span>
                    </label>
                    <div class="field-control">
                        <svg class="ico ico-lead" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M10 8.5l5 3.5-5 3.5z" /></svg>
                        <input asp-for="StartDate" type="datetime-local" class="field-input" />
                    </div>
                    <span asp-validation-for="StartDate" class="text-danger field-error"></span>
                </div>

                <span class="when-arrow" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>

                <div class="field" style="--i:5">
                    <label asp-for="EndDate" class="field-label">
                        End Date &amp; Time <span class="text-danger">*</span>
                    </label>
                    <div class="field-control">
                        <svg class="ico ico-lead" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 21V4M5 4h11l-2 4 2 4H5" /></svg>
                        <input asp-for="EndDate" type="datetime-local" class="field-input" />
                    </div>
                    <span asp-validation-for="EndDate" class="text-danger field-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-ghost">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                    Cancel
                </a>
                <button type="submit" class="btn-power">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    Create Session
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertBox" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const startInput = document.querySelector('input[name="StartDate"]');
            const endInput = document.querySelector('input[name="EndDate"]');

            if (!startInput || !endInput) return;

            const now = new Date();
            const localNow = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
                .toISOString()
                .slice(0, 16); // yyyy-MM-ddTHH:mm

            startInput.min = localNow;
            endInput.min = localNow;

            if (!startInput.value || startInput.value.startsWith("0001")) {
                startInput.value = localNow;
            }
            if (!endInput.value || endInput.value.startsWith("0001")) {
                const oneHourLater = new Date(now.getTime() + 60 * 60 * 1000);
                const localOneHourLater = new Date(oneHourLater.getTime() - now.getTimezoneOffset() * 60000)
                    .toISOString()
                    .slice(0, 16);
                endInput.value = localOneHourLater;
            }

            startInput.addEventListener("change", function () {
                endInput.min = startInput.value;
                if (endInput.value && endInput.value < startInput.value) {
                    endInput.value = "";
                }
            });
        });
    </script>

    <script>
        (function () {
            var alertEl = document.getElementById('Alert');
            if (!alertEl) return;

            var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            /* Close the alert smoothly (safe to call more than once) */
            function dismiss(el) {
                if (!el.parentNode || el.getAttribute('data-leaving')) return;
                el.setAttribute('data-leaving', '1');
                el.style.maxHeight = el.offsetHeight + 'px';
                void el.offsetHeight;
                el.classList.add('is-leaving');

                var removed = false;
                function remove() {
                    if (removed) return;
                    removed = true;
                    if (el.parentNode) el.parentNode.removeChild(el);
                }
                el.addEventListener('transitionend', function (e) {
                    if (e.target === el && e.propertyName === 'max-height') remove();
                });
                setTimeout(remove, reduce ? 0 : 500);
            }

            var closeBtn = alertEl.querySelector('.pf-alert-close');
            var timer = alertEl.querySelector('.pf-alert-timer');
            var ms = parseInt(alertEl.getAttribute('data-timeout'), 10) || 6000;

            if (closeBtn) {
                closeBtn.addEventListener('click', function () { dismiss(alertEl); });
            }

            /* Auto-dismiss: the timer bar drives the delay and pauses on hover/focus */
            if (reduce || !timer) {
                setTimeout(function () { dismiss(alertEl); }, ms);
            } else {
                timer.addEventListener('animationend', function () { dismiss(alertEl); });
            }
        })();
    </script>
}
