@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null)
    {
        return string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase)
            &&
            (action == null ||
             string.Equals(
                 currentAction,
                 action,
                 StringComparison.OrdinalIgnoreCase));
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- ^ Bootstrap 5.3.8 css file -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- ^ Our main css file -->
    <link rel="stylesheet" href="~/css/style.css" />
    <title>Power fitness | @ViewData["Title"]</title>

    <style>
        /* ============ Navbar (floating dark pill) ============ */
        .pf-header {
            --primary: #146c43;
            --primary-dark: #0e5636;
            --ink: #062117;
            --lime: #c5f04d;
            --on-dark: #e9f4ee;
            --on-dark-muted: #cfe0d6;
            --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
            position: sticky;
            top: 0;
            z-index: 1030;
            padding: 0.75rem 0;
            pointer-events: none;
        }

            .pf-header .container {
                pointer-events: none;
            }

        .pf-nav {
            position: relative;
            overflow: hidden;
            padding: 0.6rem 0.75rem calc(0.6rem + 5px) 1rem;
            border-radius: 28px;
            background: radial-gradient(520px 200px at 100% 0%, rgba(20, 108, 67, 0.7), transparent 60%), radial-gradient(360px 160px at 0% 100%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
            box-shadow: 6px 6px 0 var(--primary);
            pointer-events: auto;
        }

            .pf-nav::before {
                content: '';
                position: absolute;
                inset: 0;
                pointer-events: none;
                background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0 2px, transparent 2px 16px);
            }

            /* restricted-area tape along the bottom edge */
            .pf-nav::after {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                height: 5px;
                background: repeating-linear-gradient(-45deg, var(--ink) 0 10px, var(--lime) 10px 20px);
            }

            .pf-nav > * {
                position: relative;
                z-index: 1;
            }

        /* brand */
        .pf-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0;
            padding: 0;
            text-decoration: none;
        }

        .pf-brand-mark {
            display: grid;
            place-items: center;
            flex: none;
            width: 52px;
            height: 52px;
            overflow: hidden;
            border: 3px solid var(--lime);
            border-radius: 50%;
            background: #fff;
        }

            .pf-brand-mark img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        .pf-brand-name {
            font-family: var(--font-display);
            font-size: 1.6rem;
            font-weight: 700;
            line-height: 1;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #fff;
        }

        /* toggler (small screens) */
        .pf-nav .navbar-toggler {
            padding: 0.4rem 0.6rem;
            border: 1.5px solid var(--lime);
            border-radius: 12px;
        }

            .pf-nav .navbar-toggler:focus {
                box-shadow: 0 0 0 0.2rem rgba(197, 240, 77, 0.35);
            }

        .pf-nav .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%23c5f04d' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2.5' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* links */
        .pf-nav .navbar-nav {
            flex: 1;
            align-items: center;
            gap: 0.25rem;
        }

            .pf-nav .navbar-nav .nav-link {
                padding: 0.5rem 1.05rem;
                border: 1.5px solid transparent;
                border-radius: 999px;
                background: transparent;
                font-family: var(--font-display);
                font-size: 1.2rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                white-space: nowrap;
                color: var(--on-dark-muted);
                transition: background-color .2s ease, color .2s ease, border-color .2s ease;
            }

                .pf-nav .navbar-nav .nav-link:hover {
                    background: rgba(255, 255, 255, 0.12);
                    color: #fff;
                }

                .pf-nav .navbar-nav .nav-link.active {
                    background: var(--lime);
                    color: var(--ink);
                }

                .pf-nav .navbar-nav .nav-link:focus-visible,
                .pf-nav .pf-brand:focus-visible {
                    outline: 3px solid var(--lime);
                    outline-offset: 2px;
                }

        /* Logout / Login button (it is a real form button) */
        .pf-nav .pf-logout {
            border-color: var(--lime);
            color: var(--lime);
            cursor: pointer;
        }

        .pf-nav .navbar-nav .pf-logout:hover {
            background: var(--lime);
            color: var(--ink);
        }

        .pf-nav .pf-nav-form {
            margin: 0;
        }

        @@media (min-width: 992px) {
            .pf-nav .nav-item--end {
                margin-left: auto;
            }
        }

        @@media (max-width: 991.98px) {
            .pf-nav .navbar-collapse {
                padding-top: 0.75rem;
            }

            .pf-nav .navbar-nav {
                align-items: stretch;
            }

                .pf-nav .navbar-nav .nav-link {
                    display: block;
                    width: 100%;
                    text-align: left;
                }

            .pf-nav .nav-item--end {
                margin-top: 0.35rem;
            }
        }

        @@media (max-width: 575.98px) {
            .pf-brand-name {
                font-size: 1.35rem;
            }

            .pf-nav {
                box-shadow: 4px 4px 0 var(--primary);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .pf-nav .navbar-nav .nav-link {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <header class="pf-header">
        @if (User.Identity.IsAuthenticated)
        {
            <!-- ^ navbar -->
            <div class="container">
                <nav class="navbar navbar-expand-lg pf-nav">
                    <a class="navbar-brand pf-brand" asp-controller="Home" asp-action="Index">
                        <span class="pf-brand-mark"><img src="~/images/logo.jpg" alt="" /></span>
                        <span class="pf-brand-name">Power Fitness</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-lg-3 mb-2 mb-lg-0 mt-3 mt-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("Home") ? "active" : "")" aria-current="@(IsActive("Home") ? "page" : null)" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(IsActive("Members") ? "active" : "")" aria-current="@(IsActive("Members") ? "page" : null)" asp-controller="Members" asp-action="Index">Members</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(IsActive("Trainer") ? "active" : "")" aria-current="@(IsActive("Trainer") ? "page" : null)" asp-controller="Trainer" asp-action="Index">Trainers</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("Sessions") ? "active" : "")" aria-current="@(IsActive("Sessions") ? "page" : null)" asp-controller="Sessions" asp-action="Index">Sessions</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("Plans") ? "active" : "")" aria-current="@(IsActive("Plans") ? "page" : null)" asp-controller="Plans" asp-action="index">Plans</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("Membership") ? "active" : "")" aria-current="@(IsActive("Membership") ? "page" : null)" asp-controller="Membership" asp-action="Index">Memberships</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("Booking") ? "active" : "")" aria-current="@(IsActive("Booking") ? "page" : null)" asp-controller="Booking" asp-action="Index">Sessions Schedule</a>
                            </li>
                            <li class="nav-item nav-item--end">
                                <form asp-action="Logout" asp-controller="Account" method="post" class="pf-nav-form">
                                    <button type="submit" class="nav-link pf-logout">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>

        }
        else
        {
            <!-- ^ navbar -->
            <div class="container">
                <nav class="navbar navbar-expand-lg pf-nav">
                    <a class="navbar-brand pf-brand" asp-controller="Home" asp-action="Index">
                        <span class="pf-brand-mark"><img src="~/images/logo.jpg" alt="" /></span>
                        <span class="pf-brand-name">Power Fitness</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-lg-3 mb-2 mb-lg-0 mt-3 mt-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(IsActive("Home") ? "active" : "")" aria-current="@(IsActive("Home") ? "page" : null)" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item nav-item--end">
                                <form asp-action="Logout" asp-controller="Account" method="post" class="pf-nav-form">
                                    <button type="submit" class="nav-link pf-logout">
                                        Login
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>

        }
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
