<script>
    (function () {
        var root = document.querySelector('.pf-home');
        if (!root) return;

        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* 1. Placeholder links (href="#") should not jump to the top of the page */
        root.querySelectorAll('a[href="#"]').forEach(function (a) {
            a.addEventListener('click', function (e) { e.preventDefault(); });
        });

        /* 2. Scroll reveal */
        var reveals = root.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && !reduce) {
            var revealIO = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in');
                        revealIO.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.12 });
            reveals.forEach(function (el) { revealIO.observe(el); });
        } else {
            reveals.forEach(function (el) { el.classList.add('in'); });
        }

        /* 3. Stats count-up (the real value stays in the markup as the fallback) */
        var board = root.querySelector('.scoreboard');
        var nums = root.querySelectorAll('[data-count]');

        function countUp(el) {
            var finalText = el.textContent.trim();
            var target = parseFloat(el.getAttribute('data-count'));
            if (isNaN(target)) return;
            var duration = 1400, startTime = null;

            function tick(ts) {
                if (startTime === null) startTime = ts;
                var p = Math.min((ts - startTime) / duration, 1);
                var eased = 1 - Math.pow(1 - p, 3);
                if (p < 1) {
                    el.textContent = Math.round(target * eased);
                    requestAnimationFrame(tick);
                } else {
                    el.textContent = finalText;
                }
            }
            requestAnimationFrame(tick);
        }

        if (board && 'IntersectionObserver' in window && !reduce) {
            var countIO = new IntersectionObserver(function (entries) {
                if (entries[0].isIntersecting) {
                    nums.forEach(countUp);
                    countIO.disconnect();
                }
            }, { threshold: 0.4 });
            countIO.observe(board);
        }

        /* 4. Workout slider: arrows + indicators + keyboard scrolling */
        var slider = document.getElementById('workoutSlider');
        var prev = document.getElementById('sliderPrev');
        var next = document.getElementById('sliderNext');
        var dots = root.querySelectorAll('.indicator');

        if (slider && prev && next) {
            var slides = slider.querySelectorAll('.slide');
            var ticking = false;

            function stepSize() {
                var gap = parseFloat(getComputedStyle(slider).columnGap) || 0;
                return slides[0].getBoundingClientRect().width + gap;
            }

            function maxScroll() {
                return slider.scrollWidth - slider.clientWidth;
            }

            function currentIndex() {
                var max = maxScroll();
                if (max <= 2) return 0;
                if (slider.scrollLeft >= max - 2) return slides.length - 1;
                return Math.min(Math.round(slider.scrollLeft / stepSize()), slides.length - 1);
            }

            function update() {
                var i = currentIndex();
                dots.forEach(function (dot, k) {
                    dot.classList.toggle('active', k === i);
                    if (k === i) { dot.setAttribute('aria-current', 'true'); }
                    else { dot.removeAttribute('aria-current'); }
                });
                prev.disabled = slider.scrollLeft <= 2;
                next.disabled = slider.scrollLeft >= maxScroll() - 2;
            }

            function goTo(i) {
                slider.scrollTo({ left: i * stepSize(), behavior: reduce ? 'auto' : 'smooth' });
            }

            prev.addEventListener('click', function () { goTo(Math.max(currentIndex() - 1, 0)); });
            next.addEventListener('click', function () { goTo(Math.min(currentIndex() + 1, slides.length - 1)); });
            dots.forEach(function (dot, i) {
                dot.addEventListener('click', function () { goTo(i); });
            });

            slider.addEventListener('scroll', function () {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(function () { update(); ticking = false; });
            }, { passive: true });
            window.addEventListener('resize', update);
            update();
        }
    })();
</script>
