@using GymManagementSystem.BLL.ViewModels.HomeViewModels
@model HomeViewModel
@{
    Layout = "_Layout";
}
@{
    ViewData["Title"] = "Home";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<script>document.documentElement.classList.add('pf-js');</script>

<style>
    /* ============ Scope + tokens ============ */
    .pf-home::selection {
        background-color: #062117;
        color: white
    }
    .pf-home {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --on-dark: #e9f4ee;
        --on-dark-muted: #a9c4b6;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 1240px;
        margin-inline: auto;

        display: flex;
        flex-direction: column;
        gap: clamp(3rem, 7vw, 6rem);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-home *, .pf-home *::before, .pf-home *::after {
            box-sizing: border-box;
        }

        .pf-home h1, .pf-home h2, .pf-home h3, .pf-home p,
        .pf-home ul, .pf-home ol {
            margin: 0;
            padding: 0;
        }

        .pf-home ul, .pf-home ol {
            list-style: none;
        }

        .pf-home a {
            text-decoration: none;
        }

        .pf-home img {
            display: block;
            max-width: 100%;
        }

        .pf-home [id] {
            scroll-margin-top: 6rem;
        }

    @@media (prefers-reduced-motion: no-preference) {
        html:has(.pf-home) {
            scroll-behavior: smooth;
        }
    }

    /* ============ Shared bits ============ */
    .hl {
        padding: 0 0.18em;
        border-radius: 6px;
        background: var(--lime);
        color: var(--ink);
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    .pf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 56px;
        padding: 0 1.75rem;
        border: 0;
        border-radius: var(--radius);
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .pf-btn:active {
            transform: translateY(3px);
        }

        .pf-btn:focus-visible {
            outline: 3px solid var(--lime);
            outline-offset: 3px;
        }

    .pf-btn--lime {
        background: var(--lime);
        color: var(--ink);
        box-shadow: 0 4px 0 #7fa11f;
    }

        .pf-btn--lime:hover {
            background: #d6f77a;
        }

        .pf-btn--lime:active {
            box-shadow: 0 1px 0 #7fa11f;
        }

    .pf-btn--ghost {
        border: 2px solid rgba(233, 244, 238, 0.6);
        background: transparent;
        color: #fff;
    }

        .pf-btn--ghost:hover {
            border-color: #fff;
            background: rgba(255, 255, 255, 0.1);
        }

    .pf-btn--green {
        background: var(--primary);
        color: var(--lime);
        box-shadow: 0 4px 0 var(--primary-press);
    }

        .pf-btn--green:hover {
            background: var(--primary-dark);
        }

        .pf-btn--green:active {
            box-shadow: 0 1px 0 var(--primary-press);
        }

        .pf-btn--green:focus-visible {
            outline-color: var(--primary);
        }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--primary);
    }

        .eyebrow img {
            width: 36px;
            height: 36px;
            object-fit: contain;
            mix-blend-mode: multiply;
        }

    .section-title {
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 4.6vw, 3.75rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: var(--ink);
    }

    .section-title--md {
        font-size: clamp(2rem, 3.8vw, 3rem);
    }

    /* Scroll reveal (only hidden when JS is running) */
    .pf-js .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity .7s ease, transform .7s cubic-bezier(.2, .7, .2, 1);
    }

        .pf-js .reveal.in {
            opacity: 1;
            transform: none;
        }

    /* ============ Hero + scoreboard ============ */
    .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem) clamp(5rem, 9vw, 7rem);
        border-radius: 28px;
        background: radial-gradient(900px 480px at 100% 0%, rgba(20, 108, 67, 0.65), transparent 60%), radial-gradient(600px 400px at 0% 100%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
        color: var(--on-dark);
    }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.75rem, 6.4vw, 5.25rem);
        font-weight: 700;
        line-height: 0.95;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: #fff;
        animation: pf-rise .6s cubic-bezier(.2, .7, .2, 1) .05s backwards;
    }

    .hero-text {
        max-width: 34rem;
        margin-top: 1.25rem;
        font-size: 1.125rem;
        line-height: 1.65;
        color: var(--on-dark-muted);
        animation: pf-rise .6s cubic-bezier(.2, .7, .2, 1) .15s backwards;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
        animation: pf-rise .6s cubic-bezier(.2, .7, .2, 1) .25s backwards;
    }

    .hero-visual {
        position: relative;
        justify-self: center;
        width: 100%;
        max-width: 420px;
        animation: pf-pop .7s cubic-bezier(.2, .7, .2, 1) .2s backwards;
    }

    .hero-frame {
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border: 4px solid var(--lime);
        border-radius: 999px 999px 28px 28px;
        background: var(--primary);
        box-shadow: 14px 14px 0 var(--primary);
    }

        .hero-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
        }

    .hero-badge {
        position: absolute;
        left: -1.25rem;
        bottom: 2.5rem;
        width: 104px;
        height: 104px;
    }

        .hero-badge svg {
            width: 100%;
            height: 100%;
        }

    .badge-ring {
        fill: none;
        stroke: var(--lime);
        stroke-width: 3;
        stroke-dasharray: 3 10;
        stroke-linecap: round;
        transform-box: fill-box;
        transform-origin: center;
        animation: pf-spin 24s linear infinite;
    }

    .badge-plate {
        fill: var(--primary);
        stroke: var(--lime);
        stroke-width: 4;
    }

    .badge-bolt {
        fill: var(--lime);
    }

    .hero-wrap {
        position: relative;
    }

    .scoreboard {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        margin: -3rem clamp(0.75rem, 4vw, 3rem) 0;
        padding: clamp(1.25rem, 3vw, 2rem) clamp(0.5rem, 2vw, 1.5rem);
        border-radius: 28px 28px 28px 6px;
        background: var(--paper);
        box-shadow: 12px 12px 0 var(--primary);
        animation: pf-rise .6s cubic-bezier(.2, .7, .2, 1) .4s backwards;
    }

    .stat {
        padding: 0.25rem 0.75rem;
        text-align: center;
    }

        .stat:not(:first-child) {
            border-left: 2px dashed #c9d3cb;
        }

    .stat-num {
        display: block;
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 4vw, 3.25rem);
        font-weight: 700;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        color: var(--primary);
    }

    .stat-label {
        display: block;
        margin-top: 0.4rem;
        font-size: 0.9375rem;
        font-weight: 500;
        line-height: 1.3;
        color: var(--text-muted);
    }

    /* ============ Marquee ribbons ============ */
    .ribbon {
        overflow: hidden;
        padding: 1.75rem 0;
    }

    .marquee {
        margin-inline: -3%;
        overflow: hidden;
        background: var(--primary);
        color: #fff;
        transform: rotate(-1.5deg);
        box-shadow: 0 6px 0 var(--ink);
    }

    .ribbon--alt .marquee {
        transform: rotate(1.5deg);
    }

    .marquee-track {
        display: flex;
        width: max-content;
        animation: pf-marquee 34s linear infinite;
    }

    .ribbon--alt .marquee-track {
        animation-direction: reverse;
    }

    .marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-group {
        display: flex;
        flex: none;
        align-items: center;
        padding: 1rem 0;
    }

        .marquee-group li {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            padding-right: 1.25rem;
            font-family: var(--font-display);
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .marquee-group li img {
                width: 26px;
                height: 26px;
            }

    /* ============ About ============ */
    .about {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: center;
        padding-bottom : 30px;
    }

    .about-photo {
        aspect-ratio: 4 / 5;
        max-width: 480px;
        overflow: hidden;
        border-radius: 6px 28px 28px 28px;
        background: var(--paper);
        box-shadow: 14px 14px 0 var(--primary);
    }

        .about-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .about-copy .section-title {
        margin: 0.75rem 0 1rem;
    }

    .about-text {
        max-width: 36rem;
        font-size: 1.0625rem;
        color: var(--text-muted);
    }

    .features {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 2rem;
    }

    .feature {
        padding: 1.25rem;
        border: 1.5px solid #d9ded4;
        border-radius: 16px;
        background: var(--paper);
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

        .feature:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
            box-shadow: 0 8px 0 rgba(20, 108, 67, 0.15);
        }

    .feature-head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

        .feature-head img {
            width: 40px;
            height: 40px;
            object-fit: contain;
            mix-blend-mode: multiply;
        }

        .feature-head h3 {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: var(--ink);
        }

    .feature p {
        font-size: 0.9375rem;
        color: var(--text-muted);
    }

    .about-cta {
        margin-top: 2rem;
        text-align: center;
    }

    /* ============ Workouts slider ============ */
    .workouts {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: clamp(1.75rem, 4vw, 3.5rem);
        border-radius: 28px;
        background: radial-gradient(800px 420px at 0% 0%, rgba(20, 108, 67, 0.55), transparent 60%), var(--ink);
        color: #fff;
    }

        .workouts::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

        .workouts .eyebrow {
            color: var(--lime);
        }

        .workouts .section-title {
            max-width: 36rem;
            margin-top: 0.5rem;
            color: #fff;
        }

    .workouts-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .slider-nav {
        display: flex;
        gap: 0.75rem;
    }

    .nav-btn {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        padding: 0;
        border: 2px solid var(--lime);
        border-radius: 50%;
        background: transparent;
        color: var(--lime);
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease, opacity .2s ease;
    }

        .nav-btn svg {
            width: 22px;
            height: 22px;
        }

        .nav-btn:hover:not(:disabled) {
            background: var(--lime);
            color: var(--ink);
        }

        .nav-btn:disabled {
            opacity: 0.35;
            cursor: default;
        }

        .nav-btn:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 3px;
        }

    .slider {
        display: flex;
        gap: 1.25rem;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding-bottom: 0.25rem;
    }

        .slider::-webkit-scrollbar {
            display: none;
        }

        .slider:focus-visible {
            outline: 3px solid var(--lime);
            outline-offset: 6px;
            border-radius: 12px;
        }

    .slide {
        flex: 0 0 clamp(270px, 36%, 420px);
        overflow: hidden;
        scroll-snap-align: start;
        border-radius: 20px;
        background: #fff;
        color: var(--text);
    }

    .slide-img {
        aspect-ratio: 5 / 4;
        overflow: hidden;
    }

        .slide-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s cubic-bezier(.2, .7, .2, 1);
        }

    .slide:hover .slide-img img {
        transform: scale(1.06);
    }

    .slide-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.25rem;
    }

        .slide-foot h3 {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--primary);
        }

    .slide-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 0.25rem;
        font-weight: 600;
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--lime);
        text-decoration-thickness: 3px;
        text-underline-offset: 5px;
    }

        .slide-link:hover {
            color: var(--primary);
        }

        .slide-link:focus-visible {
            outline: 3px solid var(--primary);
            outline-offset: 2px;
        }

    .indicators {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        margin-top: 1.5rem;
    }

    .indicator {
        position: relative;
        width: 12px;
        height: 12px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: rgba(233, 244, 238, 0.35);
        cursor: pointer;
        transition: width .25s ease, background-color .25s ease;
    }

        .indicator::after {
            content: '';
            position: absolute;
            inset: -16px -6px;
        }

        .indicator.active {
            width: 36px;
            background: var(--lime);
        }

        .indicator:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 3px;
        }

    /* ============ Why us ============ */
    .why {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: center;
    }

    .why-copy .section-title {
        margin: 0.75rem 0 1rem;
    }

    .why-text {
        max-width: 36rem;
        font-size: 1.0625rem;
        margin-bottom: 1rem !important;
        color: var(--text-muted);
    }

    .why-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .why-item {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    .count {
        flex: none;
        min-width: 4rem;
        font-family: var(--font-display);
        font-size: 3.25rem;
        font-weight: 700;
        line-height: 0.9;
        color: transparent;
        -webkit-text-stroke: 2px var(--primary);
    }

    .why-item h3 {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--ink);
    }

    .why-item p {
        margin-top: 0.25rem;
        color: var(--text-muted);
    }

    .why-visual {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        align-self: stretch;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        min-height: 420px;
        padding: 1.5rem 1.5rem 0;
        border-radius: 28px;
        background: radial-gradient(520px 320px at 80% 0%, rgba(197, 240, 77, 0.18), transparent 60%), var(--primary);
    }

        .why-visual::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 16px);
        }

        .why-visual img {
            width: 100%;
            height: 100%;
            max-height: 560px;
            object-fit: contain;
        }

    /* ============ Footer ============ */
    .pf-footer {
        position: relative;
        overflow: hidden;
        padding: calc(14px + 2.5rem) clamp(1.5rem, 4vw, 3rem) 3rem;
        border-radius: 28px 28px 28px 6px;
        background: var(--paper);
        text-align: center;
    }

        .pf-footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 14px;
            background: repeating-linear-gradient(-45deg, var(--ink) 0 12px, var(--lime) 12px 24px);
        }

    .footer-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 2.5rem;
    }

    .footer-logo img {
        width: 88px;
        height: auto;
        margin: 0 auto 0.75rem;
        mix-blend-mode: multiply;
    }

    .footer-logo p {
        color: var(--text-muted);
    }

    .footer-col h3 {
        margin-bottom: 1rem;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--primary);
    }

    .contact-list li {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin-bottom: 0.6rem;
    }

    .contact-list img {
        width: 32px;
        height: 32px;
        object-fit: contain;
        mix-blend-mode: multiply;
    }

    .time-label {
        font-weight: 600;
        color: var(--ink);
    }

    .time-slot {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: var(--primary);
    }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pf-pop {
        from {
            opacity: 0;
            transform: scale(0.94);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes pf-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes pf-marquee {
        to {
            transform: translateX(-50%);
        }
    }

    /* ============ Responsive ============ */
    @@media (max-width: 991.98px) {
        .hero {
            grid-template-columns: 1fr;
        }

        .hero-visual {
            max-width: 340px;
        }

        .scoreboard {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            row-gap: 1.5rem;
        }

        .stat:nth-child(3n + 1) {
            border-left: 0;
        }

        .stat:nth-child(3n + 2), .stat:nth-child(3n) {
            border-left: 2px dashed #c9d3cb;
        }

        .about {
            grid-template-columns: 1fr;
        }

        .about-photo {
            margin-inline: auto;
        }

        .why {
            grid-template-columns: 1fr;
        }

        .why-visual {
            display: none;
        }

        .footer-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .scoreboard {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            box-shadow: 8px 8px 0 var(--primary);
        }

        .stat:nth-child(odd) {
            border-left: 0;
