@using GymManagementSystem.BLL.ViewModels.BookingViewModels
@model IEnumerable<MembersSessionViewModel>

@{
    ViewData["Title"] = "Session Attendance";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ============ Scope + tokens ============ */
    .pf-page {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --on-dark-muted: #a9c4b6;
        --danger: #b42318;
        --danger-bg: #fdecea;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 1000px;
        margin-inline: auto;
        padding: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem) 4rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-page *, .pf-page *::before, .pf-page *::after {
            box-sizing: border-box;
        }

        .pf-page h1, .pf-page h2, .pf-page p, .pf-page ul {
            margin: 0;
            padding: 0;
        }

        .pf-page ul {
            list-style: none;
        }

        .pf-page a {
            color: inherit;
            text-decoration: none;
        }

    .ico {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .hl {
        padding: 0 0.18em;
        border-radius: 6px;
        background: var(--lime);
        color: var(--ink);
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    .pf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 56px;
        padding: 0 1.75rem;
        border: 0;
        border-radius: var(--radius);
        background: var(--primary);
        color: #fff;
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        box-shadow: 0 4px 0 var(--primary-press);
        transition: background-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .pf-btn .ico {
            transition: transform .2s ease;
        }

        .pf-btn:hover {
            background: var(--primary-dark);
            color: #fff;
        }

            .pf-btn:hover .ico {
                transform: translateX(-4px);
            }

        .pf-btn:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 var(--primary-press);
        }

        .pf-btn:focus-visible {
            outline: 3px solid var(--ink);
            outline-offset: 3px;
        }

    /* ============ Alerts ============ */
    .pf-alert {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.85rem;
        padding: 1rem 1.25rem;
        border-left: 5px solid currentColor;
        border-radius: 14px;
        transition: opacity .3s ease, transform .3s ease, max-height .3s ease, margin .3s ease, padding .3s ease;
        animation: pf-rise .45s cubic-bezier(.2, .7, .2, 1) backwards;
    }

    .pf-alert--success {
        background: #e7f3ec;
        color: var(--primary);
    }

    .pf-alert--error {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .pf-alert-text {
        font-weight: 500;
        color: var(--text);
    }

    .pf-alert-close {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin: -0.5rem -0.75rem -0.5rem 0;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        transition: background-color .2s ease;
    }

        .pf-alert-close:hover {
            background: rgba(6, 33, 23, 0.1);
        }

        .pf-alert-close:focus-visible {
            outline: 3px solid currentColor;
            outline-offset: 0;
        }

    .pf-alert-timer {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 4px;
        background: currentColor;
        opacity: 0.4;
        transform-origin: left;
        animation: pf-timer var(--t, 6s) linear forwards;
    }

    .pf-alert:hover .pf-alert-timer,
    .pf-alert:focus-within .pf-alert-timer {
        animation-play-state: paused;
    }

    .pf-alert.is-leaving {
        max-height: 0 !important;
        margin-block: -0.75rem;
        padding-block: 0;
        opacity: 0;
        transform: translateY(-8px);
    }

    /* ============ Header ============ */
    .page-head {
        margin: 0.75rem 0 0.5rem;
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) backwards;
    }

    .page-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: var(--primary);
    }

    .page-sub {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 0.6rem !important;
        font-size: 1.125rem;
        color: var(--text-muted);
    }

        /* live dot: the session is running right now */
        .page-sub::before {
            content: '';
            flex: none;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--primary);
            animation: pf-pulse 1.6s ease-out infinite;
        }

    /* ============ Check-in roster ============ */
    .roster-panel {
        position: relative;
        isolation: isolate;
        padding: clamp(1rem, 3vw, 2rem);
        border-radius: 28px;
        background: radial-gradient(800px 420px at 100% 0%, rgba(20, 108, 67, 0.6), transparent 60%), radial-gradient(500px 320px at 0% 100%, rgba(197, 240, 77, 0.08), transparent 60%), var(--ink);
    }

        .roster-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            border-radius: inherit;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

    .roster {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .attendee {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem 1.25rem;
        padding: 1rem 1.25rem;
        border: 1.5px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.07);
        transition: background-color .2s ease, border-color .2s ease, transform .2s ease;
        animation: pf-rise .5s cubic-bezier(.2, .7, .2, 1) calc(var(--i, 0) * 60ms + .1s) backwards;
    }

        /* lime accent bar */
        .attendee::before {
            content: '';
            position: absolute;
            left: -1.5px;
            top: 14px;
            bottom: 14px;
            width: 5px;
            border-radius: 0 4px 4px 0;
            background: var(--lime);
            transform: scaleY(0);
            transition: transform .25s cubic-bezier(.2, .7, .2, 1);
        }

        .attendee:hover {
            border-color: rgba(197, 240, 77, 0.55);
            background: rgba(255, 255, 255, 0.11);
            transform: translateY(-2px);
        }

            .attendee:hover::before {
                transform: scaleY(1);
            }

        .attendee.is-attended {
            border-color: rgba(197, 240, 77, 0.45);
            background: rgba(197, 240, 77, 0.09);
        }

            .attendee.is-attended::before {
                transform: scaleY(1);
            }

    .avatar {
        display: grid;
        place-items: center;
        flex: none;
        width: 54px;
        height: 54px;
        border: 2px solid var(--lime);
        border-radius: 50%;
        background: var(--primary);
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: #fff;
    }

        .avatar .ico {
            width: 1.3rem;
            height: 1.3rem;
        }

    .cell-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--on-dark-muted);
    }

    .member-name {
        display: block;
        margin-top: 0.1rem;
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        overflow-wrap: anywhere;
        color: #fff;
    }

    .attendance {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.3rem;
    }

        .attendance .cell-label {
            text-align: right;
        }

    .attendance-form {
        margin: 0;
    }

    /* Attended: stamped lime pill */
    .attended {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 44px;
        padding: 0 1.1rem;
        border-radius: 999px;
        background: var(--lime);
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

        .attended .ico {
            width: 1.3rem;
            height: 1.3rem;
        }

    /* Mark as Attended button */
    .btn-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 44px;
        padding: 0 1.1rem;
        border: 1.5px solid var(--lime);
        border-radius: 10px;
        background: transparent;
        color: var(--lime);
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease, transform .15s ease;
    }

        .btn-mark .ico {
            width: 1.2rem;
            height: 1.2rem;
            transition: transform .2s ease;
        }

        .btn-mark:hover {
            background: var(--lime);
            color: var(--ink);
        }

            .btn-mark:hover .ico {
                transform: scale(1.2);
            }

        .btn-mark:active {
            transform: translateY(2px);
        }

        .btn-mark:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 3px;
        }

    .page-foot {
        margin-top: 0.5rem;
    }

    /* ============ Empty state ============ */
    .empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 3rem 1.5rem;
        border: 2px dashed #b9c6bd;
        border-radius: 28px;
        background: var(--paper);
        text-align: center;
        animation: pf-rise .5s cubic-bezier(.2, .7, .2, 1) backwards;
    }

    .empty-art {
        width: 120px;
        height: 120px;
    }

    .empty-ring {
        fill: none;
        stroke: var(--primary);
        stroke-width: 3;
        stroke-dasharray: 3 10;
        stroke-linecap: round;
        transform-box: fill-box;
        transform-origin: center;
        animation: pf-spin 24s linear infinite;
    }

    .empty-plate {
        fill: var(--primary);
        stroke: var(--lime);
        stroke-width: 4;
    }

    .empty-person {
        fill: none;
        stroke: var(--lime);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .empty-title {
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--primary);
    }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pf-timer {
        to {
            transform: scaleX(0);
        }
    }

    @@keyframes pf-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(20, 108, 67, 0.55);
        }

        100% {
            box-shadow: 0 0 0 9px rgba(20, 108, 67, 0);
        }
    }

    @@keyframes pf-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ============ Responsive ============ */
    @@media (max-width: 575.98px) {
        .pf-btn {
            width: 100%;
        }

        .attendee {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .attendance {
            grid-column: 1 / -1;
            align-items: stretch;
        }

            .attendance .cell-label {
                text-align: left;
            }

        .attended,
        .btn-mark {
            justify-content: center;
            width: 100%;
        }
    }

    /* ============ Reduced motion ============ */
    @@media (prefers-reduced-motion: reduce) {
        .pf-page *, .pf-page *::before, .pf-page *::after {
            animation: none !important;
            transition: none !important;
        }

        .attendee:hover {
            transform: none;
        }

        .pf-alert-timer {
            display: none;
        }
    }
</style>

<div class="pf-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="Alert" class="pf-alert pf-alert--success" role="status" data-timeout="6000">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
            <p class="pf-alert-text">@TempData["SuccessMessage"]</p>
            <button type="button" class="pf-alert-close" aria-label="Close">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <span class="pf-alert-timer" style="--t:6s" aria-hidden="true"></span>
        </div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div id="Alert" class="pf-alert pf-alert--error" role="alert" data-timeout="10000">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4l9 16H3z" /><path d="M12 10v4M12 17.2v.1" /></svg>
            <p class="pf-alert-text">@TempData["ErrorMessage"]</p>
            <button type="button" class="pf-alert-close" aria-label="Close">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <span class="pf-alert-timer" style="--t:10s" aria-hidden="true"></span>
        </div>
    }

    <header class="page-head">
        <h1 class="page-title">Session <span class="hl">Members</span></h1>
        <p class="page-sub">Members Attendance</p>
    </header>

    @if (Model != null && Model.Any())
    {
        var rowIndex = 0;

        <section class="roster-panel" aria-label="Members attendance">
            <ul class="roster">
                @foreach (var item in Model)
                {
                    <li class="attendee @(item.IsAttended ? "is-attended" : "")" style="--i:@(Math.Min(rowIndex++, 12))">

                        <span class="avatar" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="4" /><path d="M4 20c1-4 4-6 8-6s7 2 8 6" /></svg></span>

                        <div>
                            <span class="cell-label">Member</span>
                            <span class="member-name">@item.MemberName</span>
                        </div>

                        <div class="attendance">
                            <span class="cell-label">Attendance</span>
                            @if (item.IsAttended)
                            {
                                <span class="attended">
                                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg> Attended
                                </span>
                            }
                            else
                            {
                                <form asp-action="Attended" method="post" class="attendance-form">
                                    <input type="hidden" name="MemberId" value="@item.MemberId" />
                                    <input type="hidden" name="SessionId" value="@item.SessionId" />
                                    <button type="submit" class="btn-mark">
                                        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg> Mark as Attended
                                    </button>
                                </form>
                            }
                        </div>

                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        <div class="empty">
            <svg class="empty-art" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                <circle class="empty-ring" cx="60" cy="60" r="56" />
                <circle class="empty-plate" cx="60" cy="60" r="44" />
                <g class="empty-person">
                    <circle cx="60" cy="50" r="10" />
                    <path d="M40 82c2-12 10-18 20-18s18 6 20 18" />
                </g>
            </svg>
            <h2 class="empty-title">No Members Available</h2>
        </div>
    }

    <div class="page-foot">
        <a asp-controller="Booking" asp-action="Index" class="pf-btn">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
            Back to List
        </a>
    </div>

</div>

@section Scripts {
    <partial name="_AlertBox.cshtml" />

    <script>
        (function () {
            var root = document.querySelector('.pf-page');
            if (!root) return;

            var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            /* 1. Alert: close button + auto-dismiss (the timer bar drives the delay and pauses on hover/focus) */
            var alertEl = document.getElementById('Alert');

            function dismiss(el) {
                if (!el.parentNode || el.getAttribute('data-leaving')) return;
                el.setAttribute('data-leaving', '1');
                el.style.maxHeight = el.offsetHeight + 'px';
                void el.offsetHeight;
                el.classList.add('is-leaving');

                var removed = false;
                function remove() {
                    if (removed) return;
                    removed = true;
                    if (el.parentNode) el.parentNode.removeChild(el);
                }
                el.addEventListener('transitionend', function (e) {
                    if (e.target === el && e.propertyName === 'max-height') remove();
                });
                setTimeout(remove, reduce ? 0 : 500);
            }

            if (alertEl) {
                var closeBtn = alertEl.querySelector('.pf-alert-close');
                var timer = alertEl.querySelector('.pf-alert-timer');
                var ms = parseInt(alertEl.getAttribute('data-timeout'), 10) || 6000;

                if (closeBtn) {
                    closeBtn.addEventListener('click', function () { dismiss(alertEl); });
                }

                if (reduce || !timer) {
                    setTimeout(function () { dismiss(alertEl); }, ms);
                } else {
                    timer.addEventListener('animationend', function () { dismiss(alertEl); });
                }
            }

            /* 2. Member initials in the avatar instead of the placeholder icon */
            root.querySelectorAll('.attendee').forEach(function (row) {
                var nameEl = row.querySelector('.member-name');
                var avatar = row.querySelector('.avatar');
                if (!nameEl || !avatar) return;

                var parts = (nameEl.textContent || '').trim().split(/\s+/).filter(Boolean);
                if (!parts.length) return;

                var initials = parts[0].charAt(0);
                if (parts.length > 1) initials += parts[parts.length - 1].charAt(0);
                avatar.textContent = initials.toUpperCase();
            });
        })();
    </script>
}
