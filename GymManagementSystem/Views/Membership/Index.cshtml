@model IEnumerable<MembershipViewModel>

@{
    ViewData["Title"] = "Active Memberships";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ============ Scope + tokens ============ */
    .pf-page {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --on-dark-muted: #a9c4b6;
        --line: #6f8578;
        --danger: #b42318;
        --danger-bg: #fdecea;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 1240px;
        margin-inline: auto;
        padding: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem) 3rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-page *, .pf-page *::before, .pf-page *::after {
            box-sizing: border-box;
        }

        .pf-page h1, .pf-page h2, .pf-page p {
            margin: 0;
            padding: 0;
        }

        .pf-page a {
            color: inherit;
            text-decoration: none;
        }

    .ico {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .hl {
        padding: 0 0.18em;
        border-radius: 6px;
        background: var(--lime);
        color: var(--ink);
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    .pf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 56px;
        padding: 0 1.75rem;
        border: 0;
        border-radius: var(--radius);
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .pf-btn:active {
            transform: translateY(3px);
        }

        .pf-btn:focus-visible {
            outline: 3px solid var(--lime);
            outline-offset: 3px;
        }

    .pf-btn--lime {
        background: var(--lime);
        color: var(--ink);
        box-shadow: 0 4px 0 #7fa11f;
    }

        .pf-btn--lime:hover {
            background: #d6f77a;
        }

        .pf-btn--lime:active {
            box-shadow: 0 1px 0 #7fa11f;
        }

        .pf-btn--lime .ico {
            transition: transform .2s ease;
        }

        .pf-btn--lime:hover .ico {
            transform: rotate(90deg);
        }

    /* ============ Header ============ */
    .page-head {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 3rem);
        border-radius: 28px;
        background: radial-gradient(800px 400px at 100% 0%, rgba(20, 108, 67, 0.65), transparent 60%), radial-gradient(500px 300px at 0% 100%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) backwards;
    }

        .page-head::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

    .page-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        line-height: 0.95;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: #fff;
    }

    .page-sub {
        margin-top: 1rem !important;
        font-size: 1.125rem;
        color: var(--on-dark-muted);
    }

    /* ============ Alerts ============ */
    .pf-alert {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.85rem;
        padding: 1rem 1.25rem;
        border-left: 5px solid currentColor;
        border-radius: 14px;
        transition: opacity .3s ease, transform .3s ease, max-height .3s ease, margin .3s ease, padding .3s ease;
        animation: pf-rise .45s cubic-bezier(.2, .7, .2, 1) .1s backwards;
    }

    .pf-alert--success {
        background: #e7f3ec;
        color: var(--primary);
    }

    .pf-alert--error {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .pf-alert-text {
        font-weight: 500;
        color: var(--text);
    }

    .pf-alert-close {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin: -0.5rem -0.75rem -0.5rem 0;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        transition: background-color .2s ease;
    }

        .pf-alert-close:hover {
            background: rgba(6, 33, 23, 0.1);
        }

        .pf-alert-close:focus-visible {
            outline: 3px solid currentColor;
            outline-offset: 0;
        }

    .pf-alert-timer {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 4px;
        background: currentColor;
        opacity: 0.4;
        transform-origin: left;
        animation: pf-timer var(--t, 6s) linear forwards;
    }

    .pf-alert:hover .pf-alert-timer,
    .pf-alert:focus-within .pf-alert-timer {
        animation-play-state: paused;
    }

    .pf-alert.is-leaving {
        max-height: 0 !important;
        margin-block: -0.75rem;
        padding-block: 0;
        opacity: 0;
        transform: translateY(-8px);
    }

    /* ============ Roster card + table ============ */
    .roster {
        position: relative;
        padding: 3rem clamp(1rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2rem);
        border-radius: 28px 28px 28px 6px;
        background: var(--paper);
        box-shadow: 12px 12px 0 var(--primary);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) .15s backwards;
    }

        /* Lanyard slot */
        .roster::before {
            content: '';
            position: absolute;
            top: 16px;
            left: 50%;
            width: 56px;
            height: 8px;
            margin-left: -28px;
            border-radius: 999px;
            background: var(--ink);
        }

    .table-wrap {
        overflow-x: auto;
    }

    .pf-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

        .pf-table th {
            padding: 0.9rem 1.25rem;
            background: var(--ink);
            font-family: var(--font-display);
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
            color: var(--lime);
        }

            .pf-table th:first-child {
                border-radius: 14px 0 0 14px;
            }

            .pf-table th:last-child {
                border-radius: 0 14px 14px 0;
            }

        .pf-table tbody td {
            padding: 0.85rem 1.25rem;
            border-top: 1.5px solid #e2e6dc;
            border-bottom: 1.5px solid #e2e6dc;
            background: #fff;
            font-variant-numeric: tabular-nums;
            vertical-align: middle;
            transition: background-color .2s ease, border-color .2s ease;
            animation: pf-rise .5s cubic-bezier(.2, .7, .2, 1) calc(var(--i, 0) * 60ms + .25s) backwards;
        }

            .pf-table tbody td:first-child {
                border-left: 1.5px solid #e2e6dc;
                border-radius: 14px 0 0 14px;
            }

            .pf-table tbody td:last-child {
                border-right: 1.5px solid #e2e6dc;
                border-radius: 0 14px 14px 0;
            }

        .pf-table tbody tr:hover td {
            border-color: var(--primary);
            background: #f3f9d9;
        }

    .member {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .avatar {
        display: grid;
        place-items: center;
        flex: none;
        width: 42px;
        height: 42px;
        border: 2px solid var(--lime);
        border-radius: 50%;
        background: var(--primary);
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: #fff;
    }

        .avatar .ico {
            width: 1.2rem;
            height: 1.2rem;
        }

    .member-name {
        font-weight: 600;
        color: var(--ink);
    }

    .plan-pill {
        display: inline-block;
        padding: 0.15rem 0.8rem;
        border-radius: 999px;
        background: var(--lime);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--ink);
    }

    .cancel-form {
        margin: 0;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 44px;
        padding: 0 1rem;
        border: 1.5px solid var(--danger);
        border-radius: 10px;
        background: transparent;
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--danger);
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease, transform .15s ease;
    }

        .btn-cancel .ico {
            width: 1rem;
            height: 1rem;
        }

        .btn-cancel:hover {
            background: var(--danger);
            color: #fff;
        }

        .btn-cancel:active {
            transform: translateY(2px);
        }

        .btn-cancel:focus-visible {
            outline: 3px solid var(--danger);
            outline-offset: 3px;
        }

    /* ============ Empty state ============ */
    .empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        padding: 2.5rem 1rem;
        text-align: center;
    }

    .empty-art {
        width: 120px;
        height: 120px;
    }

    .empty-ring {
        fill: none;
        stroke: var(--primary);
        stroke-width: 3;
        stroke-dasharray: 3 10;
        stroke-linecap: round;
        transform-box: fill-box;
        transform-origin: center;
        animation: pf-spin 24s linear infinite;
    }

    .empty-plate {
        fill: var(--primary);
        stroke: var(--lime);
        stroke-width: 4;
    }

    .empty-bolt {
        fill: var(--lime);
    }

    .empty-title {
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--primary);
    }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes pf-timer {
        to { transform: scaleX(0); }
    }

    @@keyframes pf-spin {
        to { transform: rotate(360deg); }
    }

    /* ============ Responsive: rows become cards ============ */
    @@media (max-width: 767.98px) {
        .roster {
            box-shadow: 8px 8px 0 var(--primary);
        }

        .pf-table thead {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
        }

        .pf-table, .pf-table tbody, .pf-table tr, .pf-table tbody td {
            display: block;
            width: 100%;
        }

            .pf-table tbody tr {
                margin-bottom: 1rem;
                overflow: hidden;
                border: 1.5px solid #d9ded4;
                border-radius: 16px;
                background: #fff;
            }

                .pf-table tbody tr:hover td {
                    background: #f3f9d9;
                }

            .pf-table tbody td {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                border: 0;
                border-radius: 0;
                text-align: right;
            }

                .pf-table tbody td:first-child {
                    border: 0;
                    border-radius: 0;
                    background: var(--ink);
                }

                    .pf-table tbody td:first-child .member-name {
                        color: #fff;
                    }

                .pf-table tbody td:last-child {
                    border: 0;
                    border-radius: 0;
                }

                .pf-table tbody td::before {
                    content: attr(data-label);
                    font-family: var(--font-display);
                    font-size: 0.95rem;
                    font-weight: 600;
                    letter-spacing: 0.1em;
                    text-align: left;
                    text-transform: uppercase;
                    color: var(--text-muted);
                }

                .pf-table tbody td:first-child::before {
                    display: none;
                }

                .pf-table tbody tr:first-child td:first-child,
                .pf-table tbody tr:hover td:first-child {
                    background: var(--ink);
                }
    }

    @@media (max-width: 575.98px) {
        .pf-btn {
            width: 100%;
        }
    }

    /* ============ Reduced motion ============ */
    @@media (prefers-reduced-motion: reduce) {
        .pf-page *, .pf-page *::before, .pf-page *::after {
            animation: none !important;
            transition: none !important;
        }

        .pf-alert-timer {
            display: none;
        }
    }
</style>

<div class="pf-page">
    <header class="page-head">
        <div>
            <h1 class="page-title">Active <span class="hl">Memberships</span></h1>
            <p class="page-sub">Members That have Active Plans</p>
        </div>
        <div>
            <a asp-action="Create" class="pf-btn pf-btn--lime">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
                New Membership
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="Alert" class="pf-alert pf-alert--success" role="status" data-timeout="6000">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
            <p class="pf-alert-text">@TempData["SuccessMessage"]</p>
            <button type="button" class="pf-alert-close" aria-label="Close">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <span class="pf-alert-timer" style="--t:6s" aria-hidden="true"></span>
        </div>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <div id="Alert" class="pf-alert pf-alert--error" role="alert" data-timeout="10000">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4l9 16H3z" /><path d="M12 10v4M12 17.2v.1" /></svg>
            <p class="pf-alert-text">@TempData["ErrorMessage"]</p>
            <button type="button" class="pf-alert-close" aria-label="Close">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <span class="pf-alert-timer" style="--t:10s" aria-hidden="true"></span>
        </div>
    }

    <section class="roster">
        @if (Model.Any())
        {
            var rowIndex = 0;

            <div class="table-wrap">
                <table class="pf-table">
                    <thead>
                        <tr>
                            <th scope="col">Member</th>
                            <th scope="col">Plan</th>
                            <th scope="col">Start Date</th>
                            <th scope="col">End Date</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="--i:@(Math.Min(rowIndex++, 12))">
                                <td data-label="Member">
                                    <div class="member">
                                        <span class="avatar" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="4" /><path d="M4 20c1-4 4-6 8-6s7 2 8 6" /></svg></span>
                                        <span class="member-name">@item.MemberName</span>
                                    </div>
                                </td>
                                <td data-label="Plan"><span class="plan-pill">@item.PlanName</span></td>
                                <td data-label="Start Date">@item.StartDate.ToString("MMM dd, yyyy")</td>
                                <td data-label="End Date">@item.EndDate.ToString("MMM dd, yyyy")</td>
                                <td data-label="Actions">
                                    <div class="row-actions">
                                        <form method="post" asp-action="Cancel" class="cancel-form">
                                            <input type="hidden" name="id" value="@item.MemberId" />
                                            <button type="submit" class="btn-cancel">
                                                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
                                                Cancel
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty">
                <svg class="empty-art" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                    <circle class="empty-ring" cx="60" cy="60" r="56" />
                    <circle class="empty-plate" cx="60" cy="60" r="44" />
                    <polygon class="empty-bolt" points="65.6,37.6 48.8,62.8 58.6,62.8 52,82.4 71.2,55.8 61.4,55.8" />
                </svg>
                <h2 class="empty-title">No Active Memberships Available</h2>
            </div>
        }
    </section>
</div>

<script>
    (function () {
        var root = document.querySelector('.pf-page');
        if (!root) return;

        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* 1. Alert: close button + auto-dismiss (the timer bar drives the delay and pauses on hover/focus) */
        var alertEl = document.getElementById('Alert');

        function dismiss(el) {
            if (el.getAttribute('data-leaving')) return;
            el.setAttribute('data-leaving', '1');
            el.style.maxHeight = el.offsetHeight + 'px';
            void el.offsetHeight;
            el.classList.add('is-leaving');

            var removed = false;
            function remove() {
                if (removed) return;
                removed = true;
                el.remove();
            }
            el.addEventListener('transitionend', function (e) {
                if (e.target === el && e.propertyName === 'max-height') remove();
            });
            setTimeout(remove, reduce ? 0 : 500);
        }

        if (alertEl) {
            var closeBtn = alertEl.querySelector('.pf-alert-close');
            var timer = alertEl.querySelector('.pf-alert-timer');
            var ms = parseInt(alertEl.getAttribute('data-timeout'), 10) || 6000;

            if (closeBtn) {
                closeBtn.addEventListener('click', function () { dismiss(alertEl); });
            }

            if (reduce || !timer) {
                setTimeout(function () { dismiss(alertEl); }, ms);
            } else {
                timer.addEventListener('animationend', function () { dismiss(alertEl); });
            }
        }

        /* 2. Member avatars: show initials instead of the placeholder icon */
        root.querySelectorAll('.member').forEach(function (m) {
            var nameEl = m.querySelector('.member-name');
            var avatar = m.querySelector('.avatar');
            if (!nameEl || !avatar) return;

            var parts = (nameEl.textContent || '').trim().split(/\s+/).filter(Boolean);
            if (!parts.length) return;

            var initials = parts[0].charAt(0);
            if (parts.length > 1) initials += parts[parts.length - 1].charAt(0);
            avatar.textContent = initials.toUpperCase();
        });
    })();
</script>
