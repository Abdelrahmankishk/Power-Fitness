@model UpdateMemberViewModel
@{
    ViewData["Title"] = "Update Member Details";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ============ Scope + tokens ============ */
    .pf-page {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --on-dark-muted: #a9c4b6;
        --danger: #b42318;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 900px;
        margin-inline: auto;
        padding: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem) 4rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-page *, .pf-page *::before, .pf-page *::after {
            box-sizing: border-box;
        }

        .pf-page h1, .pf-page p {
            margin: 0;
            padding: 0;
        }

        .pf-page a {
            color: inherit;
            text-decoration: none;
        }

    .ico {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ============ Hero ============ */
    .page-wrap {
        position: relative;
    }

    .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: clamp(2rem, 5vw, 3.25rem) clamp(1.5rem, 5vw, 3.5rem) clamp(5rem, 9vw, 6.5rem);
        border-radius: 28px;
        background: radial-gradient(800px 420px at 100% 0%, rgba(20, 108, 67, 0.65), transparent 60%), radial-gradient(500px 320px at 0% 100%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) backwards;
    }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

    .hero-copy {
        min-width: 0;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.75rem;
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--lime);
    }

    .hero-name {
        position: relative;
        padding-bottom: 1rem;
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6.5vw, 4.5rem);
        font-weight: 700;
        line-height: 0.95;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        overflow-wrap: anywhere;
        color: #fff;
    }

        .hero-name::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 88px;
            height: 6px;
            border-radius: 999px;
            background: var(--lime);
        }

    .hero-art {
        flex: none;
        width: 120px;
        height: 120px;
    }

    .art-ring {
        fill: none;
        stroke: var(--lime);
        stroke-width: 3;
        stroke-dasharray: 3 10;
        stroke-linecap: round;
        transform-box: fill-box;
        transform-origin: center;
        animation: pf-spin 24s linear infinite;
    }

    .art-plate {
        fill: var(--primary);
        stroke: var(--lime);
        stroke-width: 4;
    }

    .art-pencil {
        fill: none;
        stroke: var(--lime);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ============ Form card ============ */
    .form-card {
        position: relative;
        z-index: 2;
        margin: -3.5rem clamp(0.5rem, 4vw, 2.5rem) 0;
        padding: clamp(1.25rem, 3vw, 2rem);
        border-radius: 28px 28px 28px 6px;
        background: var(--paper);
        box-shadow: 12px 12px 0 var(--primary);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) .2s backwards;
    }

        .form-card .text-danger {
            color: var(--danger) !important;
        }

    .fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    /* Editable tile: label + input live inside one box */
    .tile {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        min-width: 0;
        padding: 1rem 1.1rem;
        border: 1.5px solid #d9ded4;
        border-radius: 16px;
        background: #fff;
        transition: border-color .2s ease, box-shadow .2s ease;
        animation: pf-rise .45s cubic-bezier(.2, .7, .2, 1) calc(var(--i, 0) * 60ms + .3s) backwards;
    }

        .tile:hover {
            border-color: var(--primary);
        }

        .tile:focus-within {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(20, 108, 67, 0.22);
        }

        .tile:has(.input-validation-error) {
            border-color: var(--danger);
        }

            .tile:has(.input-validation-error):focus-within {
                box-shadow: 0 0 0 4px rgba(180, 35, 24, 0.2);
            }

    .tile--wide {
        grid-column: 1 / -1;
    }

    .tile-ico {
        display: grid;
        place-items: center;
        flex: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #e1efe7;
        color: var(--primary);
    }

    .tile-body {
        flex: 1;
        min-width: 0;
    }

    .tile-label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .tile-input {
        display: block;
        width: 100%;
        min-height: 44px;
        margin-top: 0.1rem;
        padding: 0.25rem 0;
        border: 0;
        border-bottom: 2px dashed #cfd8d1;
        border-radius: 0;
        background: transparent;
        font: inherit;
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--ink);
        transition: border-color .2s ease;
    }

        .tile-input:focus {
            outline: 2px solid transparent;
            border-bottom: 2px solid var(--primary);
        }

        .tile-input.input-validation-error {
            border-bottom-color: var(--danger);
        }

    .tile-error {
        display: block;
        min-height: 1.25rem;
        margin-top: 0.3rem;
        font-size: 0.875rem;
    }

    /* ============ Buttons ============ */
    .form-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.75rem;
        padding-top: 1.5rem;
        border-top: 2px dashed #b9c6bd;
    }

    .btn-ghost,
    .btn-power {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 56px;
        padding: 0 1.75rem;
        border-radius: var(--radius);
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .btn-ghost .ico,
        .btn-power .ico {
            transition: transform .2s ease;
        }

    .btn-ghost {
        border: 2px solid #6f8578;
        background: transparent;
        color: var(--ink);
    }

        .btn-ghost:hover {
            border-color: var(--ink);
            background: #e9ede4;
        }

            .btn-ghost:hover .ico {
                transform: translateX(-4px);
            }

        .btn-ghost:active {
            transform: translateY(3px);
        }

    .btn-power {
        min-width: 180px;
        border: 0;
        background: var(--primary);
        color: #fff;
        box-shadow: 0 4px 0 var(--primary-press);
    }

        .btn-power:hover {
            background: var(--primary-dark);
        }

            .btn-power:hover .ico {
                transform: scale(1.2);
            }

        .btn-power:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 var(--primary-press);
        }

    .btn-ghost:focus-visible,
    .btn-power:focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 3px;
    }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes pf-spin {
        to { transform: rotate(360deg); }
    }

    /* ============ Responsive ============ */
    @@media (max-width: 767.98px) {
        .hero-art {
            display: none;
        }
    }

    @@media (max-width: 575.98px) {
        .fields {
            grid-template-columns: 1fr;
        }

        .form-card {
            box-shadow: 8px 8px 0 var(--primary);
        }

        .btn-ghost,
        .btn-power {
            flex: 1 1 100%;
        }
    }

    /* ============ Reduced motion ============ */
    @@media (prefers-reduced-motion: reduce) {
        .pf-page *, .pf-page *::before, .pf-page *::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="pf-page">
    <div class="page-wrap">

        <header class="hero">
            <div class="hero-copy">
                <p class="eyebrow">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg>
                    @ViewData["Title"]
                </p>
                <h1 class="hero-name">@Model.Name</h1>
            </div>

            <svg class="hero-art" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                <circle class="art-ring" cx="60" cy="60" r="56" />
                <circle class="art-plate" cx="60" cy="60" r="44" />
                <g class="art-pencil">
                    <path d="M42 80h8l26-26-8-8-26 26z" />
                    <path d="M62 52l8 8" />
                </g>
            </svg>
        </header>

        <form asp-controller="Members" asp-action="EditMember" method="post" class="form-card">
            <div class="fields">

                <div class="tile tile--wide" style="--i:0">
                    <span class="tile-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M3.5 7l8.5 6 8.5-6" /></svg></span>
                    <div class="tile-body">
                        <label asp-for="Email" class="tile-label">Email</label>
                        <input asp-for="Email" class="tile-input" />
                        <span asp-validation-for="Email" class="text-danger tile-error"></span>
                    </div>
                </div>

                <div class="tile" style="--i:1">
                    <span class="tile-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" /></svg></span>
                    <div class="tile-body">
                        <label asp-for="Phone" class="tile-label">Phone</label>
                        <input asp-for="Phone" class="tile-input" />
                        <span asp-validation-for="Phone" class="text-danger tile-error"></span>
                    </div>
                </div>

                <div class="tile" style="--i:2">
                    <span class="tile-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h2M13 8h2M9 12h2M13 12h2M10 21v-4h4v4" /></svg></span>
                    <div class="tile-body">
                        <label asp-for="BuildingNumber" class="tile-label">Building Number</label>
                        <input asp-for="BuildingNumber" class="tile-input" />
                        <span asp-validation-for="BuildingNumber"
                              class="text-danger tile-error"></span>
                    </div>
                </div>

                <div class="tile" style="--i:3">
                    <span class="tile-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
                    <div class="tile-body">
                        <label asp-for="City" class="tile-label">City</label>
                        <input asp-for="City" class="tile-input" />
                        <span asp-validation-for="City" class="text-danger tile-error"></span>
                    </div>
                </div>

                <div class="tile" style="--i:4">
                    <span class="tile-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><path d="M7 3v18M17 3v18M12 5v3M12 11v3M12 17v3" /></svg></span>
                    <div class="tile-body">
                        <label asp-for="Street" class="tile-label">Street</label>
                        <input asp-for="Street" class="tile-input" />
                        <span asp-validation-for="Street" class="text-danger tile-error"></span>
                    </div>
                </div>

            </div>

            <div class="form-actions">
                <a asp-controller="Members" asp-action="Index" class="btn-ghost">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                    Back to List
                </a>
                <button type="submit" class="btn-power">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    Done
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
