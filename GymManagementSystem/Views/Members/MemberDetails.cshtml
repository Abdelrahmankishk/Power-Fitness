@model MemberViewModel
@{
    ViewData["Title"] = "Member - Details";
}
<div class="container">
    <main role="main" class="pb-3">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card card-details border-0 p-2 shadow">
                        <div class="text-center mt-3">
                            <img src="~/images/User.jpg" alt="MemberName" class="rounded-circle"
                                 style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #fff; margin-top: -60px;" />
                        </div>
                        <div class="card-body text-center">
                            <h2 class="mb-3 text-primary-color">@Model.Name</h2>
                            <h4 class="mb-2 pb-4 border-bottom d-block">@(Model.PlanName ?? "No Plan") </h4>
                            <div class="mt-4 text-start">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">Email</small>
                                            <strong class="text-success-emphasis">@Model.Email</strong>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">Phone</small>
                                            <strong class="text-success-emphasis">@Model.Phone</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">Gender</small>
                                            <strong class="text-success-emphasis">@Model.Gender</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">Date of Birth</small>
                                            <strong class="text-success-emphasis">@Model.DateOfBirth</strong>
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">Membership Start Date</small>
                                            <strong class="text-success-emphasis">@(@Model.MembershipStartDate ?? "No Active Membership")</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">Membership End Date</small>
                                            <strong class="text-success-emphasis">@(@Model.MembershipEndDate ?? "No Active Membership")</strong>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block mb-1">Address</small>
                                            <strong class="text-success-emphasis">@Model.Address</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between gap-2 px-3 pb-3">
                            <a asp-controller="Members" asp-action="Index" class="btn btn-fill flex-fill">Back to List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>
</div>