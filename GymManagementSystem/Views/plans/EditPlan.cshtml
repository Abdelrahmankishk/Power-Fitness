@model UpdatePlanViewModel
@{
    ViewData["Title"] = "Update Plan Details";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ============ Scope + tokens ============ */
    .pf-page {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --on-dark-muted: #a9c4b6;
        --line: #6f8578;
        --danger: #b42318;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 860px;
        margin-inline: auto;
        padding: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem) 4rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-page *, .pf-page *::before, .pf-page *::after {
            box-sizing: border-box;
        }

        .pf-page h1, .pf-page p {
            margin: 0;
            padding: 0;
        }

        .pf-page a {
            color: inherit;
            text-decoration: none;
        }

    .ico {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .hl {
        padding: 0 0.18em;
        border-radius: 6px;
        background: var(--lime);
        color: var(--ink);
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    /* ============ Header ============ */
    .page-head {
        margin: 0.5rem 0 1.75rem;
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) backwards;
    }

    .page-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: var(--primary);
    }

    .page-sub {
        margin-top: 0.6rem;
        font-size: 1.125rem;
        color: var(--text-muted);
    }

    /* ============ Plan card (dark name header + cream fields) ============ */
    .plan-card {
        overflow: hidden;
        border-radius: 28px 28px 28px 6px;
        background: var(--paper);
        box-shadow: 12px 12px 0 var(--primary);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) .1s backwards;
    }

        .plan-card .text-danger {
            color: var(--danger) !important;
        }

    .plan-top {
        position: relative;
        isolation: isolate;
        padding: 2.25rem clamp(1.25rem, 4vw, 2.5rem) 2rem;
        background: radial-gradient(520px 300px at 100% 0%, rgba(20, 108, 67, 0.75), transparent 60%), radial-gradient(400px 260px at 0% 100%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
    }

        .plan-top::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

        /* faint weight-plate ring in the corner */
        .plan-top::after {
            content: '';
            position: absolute;
            top: -40px;
            right: -40px;
            z-index: -1;
            width: 150px;
            height: 150px;
            border: 3px dashed rgba(197, 240, 77, 0.35);
            border-radius: 50%;
            animation: pf-spin 30s linear infinite;
        }

    .name-label {
        display: block;
        margin-bottom: 0.25rem;
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--lime);
    }

        .name-label .text-danger {
            color: #fff !important;
        }

    .name-wrap {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

        .name-wrap .ico {
            width: 1.6rem;
            height: 1.6rem;
            color: var(--on-dark-muted);
        }

    /* the read-only Name input, styled as the card title */
    .name-input {
        flex: 1;
        min-width: 0;
        padding: 0;
        border: 0;
        border-radius: 8px;
        background: transparent;
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 5.5vw, 3.5rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: #fff;
        cursor: default;
    }

        .name-input:focus-visible {
            outline: 3px solid var(--lime);
            outline-offset: 6px;
        }

    .plan-body {
        padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 4vw, 2.5rem) clamp(1.5rem, 3vw, 2rem);
    }

    .fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem 1.25rem;
    }

    .field {
        animation: pf-rise .45s cubic-bezier(.2, .7, .2, 1) calc(var(--i, 0) * 70ms + .3s) backwards;
    }

    .field--wide {
        grid-column: 1 / -1;
    }

    .field-label {
        display: block;
        margin-bottom: 0.4rem;
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--text);
    }

    .field-control {
        position: relative;
    }

        .field-control .ico {
            position: absolute;
            top: 26px;
            transform: translateY(-50%);
            color: #3f5a4b;
            pointer-events: none;
        }

        .field-control .ico-lead {
            left: 16px;
        }

    .field-input,
    .field-textarea {
        width: 100%;
        border: 1.5px solid var(--line);
        border-radius: var(--radius);
        background: #fff;
        font: inherit;
        font-size: 1rem;
        color: var(--text);
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .field-input {
        height: 52px;
        padding: 0 16px 0 48px;
    }

    .field-textarea {
        display: block;
        min-height: 140px;
        padding: 14px 16px;
        line-height: 1.5;
        resize: vertical;
    }

    .field-input:hover,
    .field-textarea:hover {
        border-color: var(--primary);
    }

    .field-input:focus,
    .field-textarea:focus {
        outline: 2px solid transparent;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(20, 108, 67, 0.22);
    }

    .field-input.input-validation-error,
    .field-textarea.input-validation-error {
        border-color: var(--danger);
    }

        .field-input.input-validation-error:focus,
        .field-textarea.input-validation-error:focus {
            box-shadow: 0 0 0 4px rgba(180, 35, 24, 0.2);
        }

    .hint {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.875rem;
        color: var(--text-muted);
    }

    .field-error {
        display: block;
        min-height: 1.25rem;
        margin-top: 0.35rem;
        font-size: 0.875rem;
    }

    /* ============ Buttons ============ */
    .form-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.75rem;
        padding-top: 1.5rem;
        border-top: 2px dashed #b9c6bd;
    }

    .btn-ghost,
    .btn-power {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 56px;
        padding: 0 1.75rem;
        border-radius: var(--radius);
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .btn-ghost .ico,
        .btn-power .ico {
            transition: transform .2s ease;
        }

    .btn-ghost {
        border: 2px solid var(--line);
        background: transparent;
        color: var(--ink);
    }

        .btn-ghost:hover {
            border-color: var(--ink);
            background: #e9ede4;
        }

            .btn-ghost:hover .ico {
                transform: translateX(-4px);
            }

        .btn-ghost:active {
            transform: translateY(3px);
        }

    .btn-power {
        border: 0;
        background: var(--primary);
        color: #fff;
        box-shadow: 0 4px 0 var(--primary-press);
    }

        .btn-power:hover {
            background: var(--primary-dark);
        }

            .btn-power:hover .ico {
                transform: scale(1.2);
            }

        .btn-power:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 var(--primary-press);
        }

    .btn-ghost:focus-visible,
    .btn-power:focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 3px;
    }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes pf-spin {
        to { transform: rotate(360deg); }
    }

    /* ============ Responsive ============ */
    @@media (max-width: 575.98px) {
        .fields {
            grid-template-columns: 1fr;
        }

        .plan-card {
            box-shadow: 8px 8px 0 var(--primary);
        }

        .btn-ghost,
        .btn-power {
            flex: 1 1 100%;
        }
    }

    /* ============ Reduced motion ============ */
    @@media (prefers-reduced-motion: reduce) {
        .pf-page *, .pf-page *::before, .pf-page *::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="pf-page">

    <header class="page-head">
        <h1 class="page-title">Edit <span class="hl">Plan</span></h1>
        <p class="page-sub">Update plan details</p>
    </header>

    <form asp-action="EditPlan" method="post" class="plan-card">

        <div class="plan-top">
            <label asp-for="Name" class="name-label">
                Plan Name <span class="text-danger">*</span>
            </label>
            <div class="name-wrap">
                <input asp-for="Name" class="name-input" readonly />
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" /></svg>
            </div>
        </div>

        <div class="plan-body">
            <div class="fields">

                <div class="field" style="--i:0">
                    <label asp-for="DurationDays" class="field-label">
                        Duration (Days) <span class="text-danger">*</span>
                    </label>
                    <div class="field-control">
                        <svg class="ico ico-lead" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4" /></svg>
                        <input asp-for="DurationDays" type="number" class="field-input" />
                    </div>
                    <small class="hint">e.g., 30 days = 1 month</small>
                    <span asp-validation-for="DurationDays" class="text-danger field-error"></span>
                </div>

                <div class="field" style="--i:1">
                    <label asp-for="Price" class="field-label">
                        Price (EGP) <span class="text-danger">*</span>
                    </label>
                    <div class="field-control">
                        <svg class="ico ico-lead" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M14.5 9.2c-.5-.8-1.5-1.2-2.5-1.2-1.4 0-2.5.8-2.5 2s1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-2-.4-2.5-1.2M12 6.5V8M12 16v1.5" /></svg>
                        <input asp-for="Price" type="number" step="0.01" class="field-input" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger field-error"></span>
                </div>

                <div class="field field--wide" style="--i:2">
                    <label asp-for="Description" class="field-label">
                        Description <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Description" class="field-textarea" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger field-error"></span>
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-ghost">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                    Cancel
                </a>
                <button type="submit" class="btn-power">
                    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    Update Plan
                </button>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
