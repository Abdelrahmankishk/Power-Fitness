@model PLanViewModel
@{
    ViewData["Title"] = "Plan - Details";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ============ Scope + tokens ============ */
    .pf-page {
        --primary: #146c43;
        --primary-dark: #0e5636;
        --primary-press: #0a3f27;
        --ink: #062117;
        --lime: #c5f04d;
        --paper: #f6f4ec;
        --text: #10241b;
        --text-muted: #4b5f55;
        --on-dark-muted: #a9c4b6;
        --danger: #b42318;
        --danger-bg: #fdecea;
        --radius: 12px;
        --font-display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
        --font-body: 'Barlow', 'Segoe UI', system-ui, sans-serif;
        max-width: 900px;
        margin-inline: auto;
        padding: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem) 4rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.6;
        color: var(--text);
    }

        .pf-page *, .pf-page *::before, .pf-page *::after {
            box-sizing: border-box;
        }

        .pf-page h1, .pf-page p {
            margin: 0;
            padding: 0;
        }

        .pf-page a {
            color: inherit;
            text-decoration: none;
        }

    .ico {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ============ Membership pass ============ */
    .pass {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 270px;
        margin-top: 0.5rem;
        padding: clamp(1.5rem, 4vw, 2.5rem);
        border-radius: 28px 28px 28px 6px;
        animation: pf-pop .6s cubic-bezier(.2, .7, .2, 1) backwards;
    }

        .pass::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 16px);
        }

        /* large weight-plate ring cropped in the corner */
        .pass::after {
            content: '';
            position: absolute;
            right: -70px;
            bottom: -70px;
            z-index: -1;
            width: 260px;
            height: 260px;
            border: 4px dashed rgba(197, 240, 77, 0.3);
            border-radius: 50%;
            animation: pf-spin 40s linear infinite;
        }

    .pass--active {
        background: radial-gradient(640px 360px at 100% 0%, rgba(20, 108, 67, 0.8), transparent 60%), radial-gradient(420px 300px at 0% 100%, rgba(197, 240, 77, 0.10), transparent 60%), var(--ink);
        color: #fff;
        box-shadow: 12px 12px 0 var(--primary);
    }

    .pass--inactive {
        border: 2px dashed #b9c6bd;
        background: #e8ebe4;
        color: var(--text-muted);
    }

        .pass--inactive::before {
            background: repeating-linear-gradient(135deg, rgba(6, 33, 23, 0.03) 0 2px, transparent 2px 16px);
        }

        .pass--inactive::after {
            border-color: rgba(6, 33, 23, 0.12);
        }

    .pass-name {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 6vw, 3.5rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        overflow-wrap: anywhere;
    }

        .pass-name .ico {
            width: 1.1em;
            height: 1.1em;
        }

    .pass--active .pass-name {
        color: #fff;
    }

        .pass--active .pass-name .ico {
            color: var(--lime);
        }

    .pass--inactive .pass-name {
        color: #3f5a4b;
    }

        .pass--inactive .pass-name .ico {
            color: #8aa093;
        }

    .pass-price {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
    }

    .price-num {
        font-family: var(--font-display);
        font-size: clamp(4.5rem, 14vw, 8rem);
        font-weight: 700;
        line-height: 0.85;
        font-variant-numeric: tabular-nums;
    }

    .pass--active .price-num {
        color: var(--lime);
    }

    .pass--inactive .price-num {
        color: #587263;
    }

    .price-cur {
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .pass--active .price-cur {
        color: var(--on-dark-muted);
    }

    /* ============ Details card ============ */
    .details {
        padding: clamp(1.25rem, 3vw, 2rem);
        border-radius: 28px 28px 28px 6px;
        background: var(--paper);
        box-shadow: 12px 12px 0 var(--primary);
        animation: pf-rise .55s cubic-bezier(.2, .7, .2, 1) .2s backwards;
    }

    .tiles {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .tile {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-width: 0;
        padding: 1rem 1.1rem;
        border: 1.5px solid #e2e6dc;
        border-radius: 16px;
        background: #fff;
        transition: border-color .2s ease, transform .2s ease;
        animation: pf-rise .45s cubic-bezier(.2, .7, .2, 1) calc(var(--i, 0) * 70ms + .3s) backwards;
    }

        .tile:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

    .tile--wide {
        grid-column: 1 / -1;
        align-items: flex-start;
    }

    .tile-ico {
        display: grid;
        place-items: center;
        flex: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #e1efe7;
        color: var(--primary);
    }

        .tile-ico.is-off {
            background: var(--danger-bg);
            color: var(--danger);
        }

    .tile-body {
        min-width: 0;
    }

    .tile-label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .tile-value {
        display: block;
        margin-top: 0.1rem;
        font-size: 1.0625rem;
        font-weight: 600;
        overflow-wrap: anywhere;
        color: var(--ink);
    }

    .tile-text {
        margin-top: 0.1rem;
        overflow-wrap: anywhere;
        color: var(--text);
    }

    .badge {
        display: inline-block;
        margin-top: 0.15rem;
        padding: 0.1rem 0.9rem;
        border-radius: 999px;
        font-size: 0.9375rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .badge--on {
        background: var(--lime);
        color: var(--ink);
    }

    .badge--off {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .actions {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 2px dashed #b9c6bd;
    }

    .btn-power {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 56px;
        padding: 0 1.5rem;
        border-radius: var(--radius);
        background: var(--primary);
        color: #fff;
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        box-shadow: 0 4px 0 var(--primary-press);
        transition: background-color .2s ease, transform .15s ease, box-shadow .15s ease;
    }

        .btn-power .ico {
            transition: transform .2s ease;
        }

        .btn-power:hover {
            background: var(--primary-dark);
            color: #fff;
        }

            .btn-power:hover .ico {
                transform: translateX(-4px);
            }

        .btn-power:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 var(--primary-press);
        }

        .btn-power:focus-visible {
            outline: 3px solid var(--ink);
            outline-offset: 3px;
        }

    /* ============ Keyframes ============ */
    @@keyframes pf-rise {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pf-pop {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes pf-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ============ Responsive ============ */
    @@media (max-width: 575.98px) {
        .tiles {
            grid-template-columns: 1fr;
        }

        .pass--active,
        .details {
            box-shadow: 8px 8px 0 var(--primary);
        }
    }

    /* ============ Reduced motion ============ */
    @@media (prefers-reduced-motion: reduce) {
        .pf-page *, .pf-page *::before, .pf-page *::after {
            animation: none !important;
            transition: none !important;
        }

        .tile:hover {
            transform: none;
        }
    }
</style>

<div class="pf-page">

    <section class="pass @(Model.IsActive ? "pass--active" : "pass--inactive")" aria-labelledby="plan-name">
        <h1 id="plan-name" class="pass-name">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="5" /><path d="M8.5 13.5L7 21l5-3 5 3-1.5-7.5" /></svg>
            @Model.Name
        </h1>

        <p class="pass-price">
            <span class="price-num">@Model.Price</span>
            <span class="price-cur">EGP</span>
        </p>
    </section>

    <section class="details">
        <div class="tiles">

            <div class="tile" style="--i:0">
                <span class="tile-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4" /></svg></span>
                <div class="tile-body">
                    <span class="tile-label">Duration</span>
                    <strong class="tile-value">@Model.DurationDays days</strong>
                </div>
            </div>

            <div class="tile" style="--i:1">
                <span class="tile-ico @(Model.IsActive ? "" : "is-off")" aria-hidden="true">
                    @if (Model.IsActive)
                    {
                        <svg class="ico" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
                    }
                    else
                    {
                        <svg class="ico" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M9 9l6 6M15 9l-6 6" /></svg>
                    }
                </span>
                <div class="tile-body">
                    <span class="tile-label">Status</span>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge--on">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge badge--off">
                            Inactive
                        </span>
                    }
                </div>
            </div>

            <div class="tile tile--wide" style="--i:2">
                <span class="tile-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" focusable="false"><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 13h7M9 17h5" /></svg></span>
                <div class="tile-body">
                    <span class="tile-label">Description</span>
                    <p class="tile-text">@Model.Description</p>
                </div>
            </div>

        </div>

        <div class="actions">
            <a asp-action="Index" class="btn-power">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                Back
            </a>
        </div>
    </section>

</div>
